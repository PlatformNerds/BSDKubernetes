From 7147f2a6b5b0cc4ea2177fc361f9cac9c704ab17 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Mon, 23 Nov 2026 12:18:30 -0700
Subject: [PATCH] pf: advertise the outbound rdr-to sticky-address fix as a
 kernel feature

Userland that sets sticky-address on outbound rdr-to rules (kube-proxy's
pf backend, for Services with sessionAffinity: ClientIP reached from the
host) needs to know whether the kernel records the redirect target for
them. Advertise it as kern.features.pf_rdr_out_sticky.
---
 sys/netpfil/pf/pf.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/sys/netpfil/pf/pf.c b/sys/netpfil/pf/pf.c
index ad4958565..e540e8a23 100644
--- a/sys/netpfil/pf/pf.c
+++ b/sys/netpfil/pf/pf.c
@@ -120,6 +120,13 @@
 #include <security/mac/mac_framework.h>
 
 SDT_PROVIDER_DEFINE(pf);
+
+/*
+ * sticky-address records the redirect target, not the source, for outbound
+ * rdr-to rules, so a host's own connections to a redirected address can be
+ * kept on one target (e.g. Kubernetes sessionAffinity for host clients).
+ */
+FEATURE(pf_rdr_out_sticky, "pf sticky-address works with outbound rdr-to");
 SDT_PROBE_DEFINE2(pf, , test, reason_set, "int", "int");
 SDT_PROBE_DEFINE4(pf, ip, test, done, "int", "int", "struct pf_krule *",
     "struct pf_kstate *");
