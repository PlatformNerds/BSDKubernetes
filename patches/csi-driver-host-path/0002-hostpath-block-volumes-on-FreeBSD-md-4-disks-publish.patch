+
+package hostpath
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strings"
+
+	"k8s.io/klog/v2"
+	"k8s.io/mount-utils"
+)
+
+// Block volumes on FreeBSD. The backing file becomes a disk with md(4) in
+// vnode mode, FreeBSD's loop device; the driver runs privileged, so it sees
+// /dev/mdctl. FreeBSD has no block devices: disks are character devices, and
+// nullfs can't bind-mount a device node, so the publish target is a symbolic
+// link to the disk. The kubelet resolves it on the host and maps the disk
+// into the container (see the BSDKubernetes kubelet and CRI-O patches).
+
+// createBlockFile makes the backing file (sparse, like fallocate's result
+// reads as zeros).
+func createBlockFile(path string, size int64) error {
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)
+	if err != nil {
+		return err
+	}
+	if err := f.Truncate(size); err != nil {
+		f.Close()
+		return err
+	}
+	return f.Close()
+}
+
+// attachFileDevice attaches path to an md(4) disk, unless one is attached
+// already, and returns the disk's path.
+func attachFileDevice(path string) (string, error) {
+	if dev, err := getLoopDevice(path); err == nil {
+		return dev, nil
+	}
+	out, err := exec.Command("mdconfig", "-a", "-t", "vnode", "-f", path).CombinedOutput()
+	if err != nil {
+		return "", fmt.Errorf("mdconfig -a -t vnode -f %s: %v: %s", path, err, out)
+	}
+	return "/dev/" + strings.TrimSpace(string(out)), nil
+}
+
+// getLoopDevice returns the md(4) disk attached to path.
+func getLoopDevice(path string) (string, error) {
+	out, err := exec.Command("mdconfig", "-l", "-f", path).CombinedOutput()
+	if err != nil {
+		return "", fmt.Errorf("mdconfig -l -f %s: %v: %s", path, err, out)
+	}
+	units := strings.Fields(string(out))
+	if len(units) == 0 {
+		return "", fmt.Errorf("no md device for %s", path)
+	}
+	return "/dev/" + units[0], nil
+}
+
+// detachFileDevice detaches the md(4) disks attached to path, if any.
+func detachFileDevice(path string) error {
+	out, err := exec.Command("mdconfig", "-l", "-f", path).CombinedOutput()
+	if err != nil {
+		return fmt.Errorf("mdconfig -l -f %s: %v: %s", path, err, out)
+	}
+	for _, unit := range strings.Fields(string(out)) {
+		klog.V(4).Infof("detaching %s from %s", unit, path)
+		if out, err := exec.Command("mdconfig", "-d", "-u", unit).CombinedOutput(); err != nil {
+			return fmt.Errorf("mdconfig -d -u %s: %v: %s", unit, err, out)
+		}
+	}
+	return nil
+}
+
+// publishBlock makes targetPath a link to the disk.
+func publishBlock(_ mount.Interface, device, targetPath string) error {
+	if err := os.Remove(targetPath); err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	return os.Symlink(device, targetPath)
+}
diff --git a/pkg/hostpath/block_other.go b/pkg/hostpath/block_other.go
new file mode 100644
index 0000000..bfbf854
--- /dev/null
+++ b/pkg/hostpath/block_other.go
@@ -0,0 +1,51 @@
+//go:build !freebsd
+
+/*
+Copyright 2026 The Kubernetes Authors.
+
