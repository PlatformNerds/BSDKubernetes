From e98531912123758ac2428fed30c654ba1dfe668b Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Thu, 19 Nov 2026 17:53:32 -0700
Subject: [PATCH] kube-proxy: apply the conntrack settings to pf on FreeBSD

On Linux kube-proxy sets the nf_conntrack sysctls from its conntrack
configuration; the pf proxier ignored it. pf's state table is the
counterpart, so set its global options instead (pfctl -m -O: only these
options, rules untouched):

- maxPerCore x CPUs (at least min, capped at 1M) -> limit states
  (pfctl scales the adaptive timeout thresholds with it)
- tcpEstablishedTimeout -> timeout tcp.established
- tcpCloseWaitTimeout -> timeout tcp.closing: pf's timeout once one side
  has sent a FIN. pf's default is 15 minutes against kube-proxy's hour,
  so a half-closed connection through a Service lost its translation
  after 15 idle minutes.
- udpTimeout / udpStreamTimeout -> timeout udp.single / udp.multiple

Unset or zero values leave pf alone, as on Linux; tcpBeLiberal has no
global pf counterpart and is logged.
---
 cmd/kube-proxy/app/server_freebsd.go |  6 ++
 pkg/proxy/pf/stateopts.go            | 95 ++++++++++++++++++++++++++++
 pkg/proxy/pf/stateopts_test.go       | 67 ++++++++++++++++++++
 3 files changed, 168 insertions(+)
 create mode 100644 pkg/proxy/pf/stateopts.go
 create mode 100644 pkg/proxy/pf/stateopts_test.go

diff --git a/cmd/kube-proxy/app/server_freebsd.go b/cmd/kube-proxy/app/server_freebsd.go
index 8399f0fc8a3..9b8e2afee93 100644
--- a/cmd/kube-proxy/app/server_freebsd.go
+++ b/cmd/kube-proxy/app/server_freebsd.go
@@ -24,6 +24,7 @@ import (
 	"context"
 	"errors"
 	"fmt"
+	goruntime "runtime"
 	"time"
 
 	// Enable pprof HTTP handlers.
@@ -68,6 +69,11 @@ func (o *Options) platformApplyDefaults(config *proxyconfigapi.KubeProxyConfigur
 // platform-specific setup.
 func (s *ProxyServer) platformSetup(ctx context.Context) error {
 	logger := klog.FromContext(ctx)
+	// The conntrack settings, applied to pf's state table (Linux sets the
+	// nf_conntrack sysctls here).
+	if err := pf.SetStateOptions(ctx, exec.New(), &s.Config.Linux.Conntrack, goruntime.NumCPU()); err != nil {
+		return fmt.Errorf("could not set pf state options from kube-proxy configuration: %w", err)
+	}
 	if s.Config.DetectLocalMode == proxyconfigapi.LocalModeNodeCIDR {
 		logger.Info("Watching for node, awaiting podCIDR allocation", "hostname", s.NodeName)
 		node, err := waitForPodCIDR(ctx, s.Client, s.NodeName)
