+// newSniffer returns where to read the TCP segments sent to ip: on Linux,
+// the raw ip:tcp socket itself, which gets a copy of every TCP packet.
+func newSniffer(conn *net.IPConn, ip net.IP) (packetReader, error) {
+	return conn, nil
+}
