From 6c33e4f8ccc6571516870fd3817e9f58f3e05f34 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Tue, 17 Nov 2026 19:02:24 -0700
Subject: [PATCH 20/20] sockstat: show abstract AF_UNIX addresses as "@name"

An abstract address starts with a NUL byte, so sockstat printed it as an
empty string.  Print it as Linux ss(8) does: '@' followed by the name,
with each NUL shown as '@'.  An all-zero address is unnamed and prints
as before.
---
 usr.bin/sockstat/main.c | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/usr.bin/sockstat/main.c b/usr.bin/sockstat/main.c
index df09245a8..9c0b74d3d 100644
--- a/usr.bin/sockstat/main.c
+++ b/usr.bin/sockstat/main.c
@@ -915,6 +915,32 @@ formataddr(struct sockaddr_storage *ss, char *buf, size_t bufsize)
 	case AF_UNIX:
 		sun = sstosun(ss);
 		off = (int)((char *)&sun->sun_path - (char *)sun);
+		if (sun->sun_len > off && sun->sun_path[0] == '\0') {
+			/*
+			 * An abstract address: a name in no file system, all of
+			 * whose bytes count.  Show it as Linux ss(8) does, with
+			 * each NUL as '@'.  All-zero is an unnamed address.
+			 */
+			char abs[sizeof(sun->sun_path) + 1];
+			int i, len;
+			bool named = false;
+
+			len = MIN(sun->sun_len - off, (int)sizeof(sun->sun_path));
+			for (i = 0; i < len; i++) {
+				abs[i] = sun->sun_path[i] == '\0' ? '@' :
+				    sun->sun_path[i];
+				if (sun->sun_path[i] != '\0')
+					named = true;
+			}
+			abs[len] = '\0';
+			if (named) {
+				if (is_xo_style_encoding) {
+					xo_emit("{:path/%s}", abs);
+					return (0);
+				}
+				return (snprintf(buf, bufsize, "%s", abs));
+			}
+		}
 		if (is_xo_style_encoding) {
 			xo_emit("{:path/%.*s}", sun->sun_len - off,
 				sun->sun_path);
-- 
