+package mounttest
+
+import (
+	"strconv"
+	"syscall"
+)
+
+// statfsTypeName returns the filesystem type name of buf. FreeBSD assigns
+// filesystem type numbers (f_type) dynamically at boot, so report
+// f_fstypename instead, e.g. "tmpfs" for an emptyDir with medium Memory.
+func statfsTypeName(buf *syscall.Statfs_t) string {
+	n := make([]byte, 0, len(buf.Fstypename))
+	for _, c := range buf.Fstypename {
+		if c == 0 {
+			break
+		}
+		n = append(n, byte(c))
+	}
+	if len(n) == 0 {
+		return formatFsType(int64(buf.Type))
+	}
+	return string(n)
+}
+
+// formatFsType returns a string representation of the filesystem type number.
+func formatFsType(fsType int64) string {
+	return strconv.FormatInt(fsType, 10)
+}
diff --git a/test/images/agnhost/mounttest/mt_utils_linux.go b/test/images/agnhost/mounttest/mt_utils_linux.go
index 532aa1e82cd..a35d2ec084c 100644
--- a/test/images/agnhost/mounttest/mt_utils_linux.go
+++ b/test/images/agnhost/mounttest/mt_utils_linux.go
@@ -20,10 +20,16 @@ package mounttest
 
 import (
 	"strconv"
+	"syscall"
 
 	"golang.org/x/sys/unix"
 )
 
+// statfsTypeName returns a string representation of the filesystem type of buf.
+func statfsTypeName(buf *syscall.Statfs_t) string {
+	return formatFsType(int64(buf.Type))
+}
+
 // formatFsType returns a string representation of the filesystem type.
 // It translates known filesystem magic numbers to human-readable names.
 func formatFsType(fsType int64) string {
