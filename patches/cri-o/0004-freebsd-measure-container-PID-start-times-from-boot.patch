From 47af3bdfb5d320b7d6dc3a1d6c30a0c5b7d0f8b6 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Sun, 15 Nov 2026 15:08:02 -0700
Subject: [PATCH 4/6] freebsd: measure container PID start times from boot

CRI-O checks that a container's PID still has the start time saved at
creation (PID reuse). On FreeBSD that was kinfo_proc ki_start, which is
wall-clock time: the kernel computes it as boot time + the start's offset
from boot, and stepping the clock (ntpd -g at boot, ntpdate) moves the boot
time and every process's ki_start with it. After ntpd stepped a node's clock
by 1.4 s, exec into its containers failed with 'PID ... is running but has
start time of X, whereas the saved start time is Y. PID wrap may have
occurred'.

Use ki_start - kern.boottime (read before and after, retrying if a step
happens in between), saved with a 'boot:' prefix; Linux likewise uses the
start time in ticks since boot. Start times saved by older versions
(wall-clock, no prefix) are still compared as before, so existing
containers keep working across the upgrade. Test.
---
 internal/oci/container.go               |  2 +-
 internal/oci/container_freebsd.go       | 58 +++++++++++++++++++++++--
 internal/oci/container_freebsd_nocgo.go |  6 +++
 internal/oci/container_freebsd_test.go  | 43 ++++++++++++++++++
 internal/oci/container_linux.go         |  6 +++
 internal/oci/container_unsupported.go   |  6 +++
 6 files changed, 117 insertions(+), 4 deletions(-)
 create mode 100644 internal/oci/container_freebsd_test.go

diff --git a/internal/oci/container.go b/internal/oci/container.go
index e0ae6533d..7b1847e64 100644
--- a/internal/oci/container.go
+++ b/internal/oci/container.go
@@ -646,7 +646,7 @@ func (c *Container) verifyPid() (string, error) {
 		return "", err
 	}
 
-	if c.state.InitStartTime != startTime {
+	if !startTimesMatch(c.state.InitStartTime, startTime, c.state.InitPid) {
 		return "", fmt.Errorf(
 			"PID %d is running but has start time of %s, whereas the saved start time is %s. PID wrap may have occurred",
 			c.state.InitPid, startTime, c.state.InitStartTime,
diff --git a/internal/oci/container_freebsd.go b/internal/oci/container_freebsd.go
index 303b00c98..f064ddcfa 100644
--- a/internal/oci/container_freebsd.go
+++ b/internal/oci/container_freebsd.go
@@ -8,6 +8,7 @@ import "C"
 
 import (
 	"fmt"
+	"strings"
 	"unsafe"
 
 	specs "github.com/opencontainers/runtime-spec/specs-go"
@@ -18,11 +19,30 @@ import (
 
 const sysctlName = "kern.proc.pid"
 
+// bootRelativePrefix marks a start time measured from boot (see
+// getPidStatDataFromSysctl); saved start times without it are wall-clock
+// times recorded by older CRI-O versions.
+const bootRelativePrefix = "boot:"
+
 // getPidStartTime returns the process start time for a given PID.
 func getPidStartTime(pid int) (string, error) {
 	return getPidStatDataFromSysctl(pid)
 }
 
+// startTimesMatch reports whether a process start time saved for a
+// container's PID matches the PID's current one (no PID reuse).
+func startTimesMatch(saved, current string, pid int) bool {
+	if saved == current {
+		return true
+	}
+	if strings.HasPrefix(saved, bootRelativePrefix) {
+		return false
+	}
+	// Saved by an older CRI-O as wall-clock time: compare like it did.
+	abs, _, err := kinfoStartTime(pid)
+	return err == nil && saved == fmt.Sprintf("%d,%d", abs.Sec, abs.Usec)
+}
+
 // getPidStatData returns the process state and start time for a given PID.
 //
 // TODO: Return the process state using struct kinfo_proc.
@@ -36,19 +56,51 @@ func getPidStatData(pid int) (string, string, error) { //nolint:gocritic // Igno
 // when /proc is not mounted, which not a requirement on FreeBSD.
 //
 // TODO: Add process state collection using struct kinfo_proc.
+//
+// The start time is returned relative to boot. The kernel reports ki_start as
+// wall-clock time (boot time + the start's offset from boot), and stepping
+// the clock (ntpd -g at boot, ntpdate, settimeofday) moves the boot time and
+// with it every process's ki_start: CRI-O then took the container's PID for
+// a reused one ("PID wrap may have occurred") and refused exec and other
+// operations on it. Linux uses the start time in ticks since boot, which
+// clock steps don't change; ki_start - kern.boottime is the equivalent.
 func getPidStatDataFromSysctl(pid int) (string, error) {
+	for range 3 {
+		before, err := unix.SysctlTimeval("kern.boottime")
+		if err != nil {
+			return "", err
+		}
+		start, _, err := kinfoStartTime(pid)
+		if err != nil {
+			return "", err
+		}
+		after, err := unix.SysctlTimeval("kern.boottime")
+		if err != nil {
+			return "", err
+		}
+		if before != after {
+			continue // the clock was stepped meanwhile
+		}
+		rel := unix.NsecToTimeval(start.Nano() - after.Nano())
+		return fmt.Sprintf("%s%d,%06d", bootRelativePrefix, rel.Sec, rel.Usec), nil
+	}
+	return "", fmt.Errorf("boot time kept changing while reading the start time of PID %d", pid)
+}
+
+// kinfoStartTime returns the process's ki_start (wall-clock) from kinfo_proc.
+func kinfoStartTime(pid int) (unix.Timeval, *C.struct_kinfo_proc, error) {
 	data, err := unix.SysctlRaw(sysctlName, pid)
 	if err != nil {
-		return "", err
+		return unix.Timeval{}, nil, err
 	}
 
 	if len(data) != C.sizeof_struct_kinfo_proc {
-		return "", fmt.Errorf("incorrect read of %d bytes from %s sysctl", len(data), sysctlName)
+		return unix.Timeval{}, nil, fmt.Errorf("incorrect read of %d bytes from %s sysctl", len(data), sysctlName)
 	}
 
 	kp := (*C.struct_kinfo_proc)(unsafe.Pointer(&data[0]))
 
-	return fmt.Sprintf("%d,%d", kp.ki_start.tv_sec, kp.ki_start.tv_usec), nil
+	return unix.Timeval{Sec: int64(kp.ki_start.tv_sec), Usec: int64(kp.ki_start.tv_usec)}, kp, nil
 }
 
 // SetRuntimeUser sets the runtime user for the container.
diff --git a/internal/oci/container_freebsd_nocgo.go b/internal/oci/container_freebsd_nocgo.go
index eed5b01cc..fe81ffaf3 100644
--- a/internal/oci/container_freebsd_nocgo.go
+++ b/internal/oci/container_freebsd_nocgo.go
@@ -53,3 +53,9 @@ func getPidStatDataFromFile(file string) (string, error) {
 func (c *Container) SetRuntimeUser(spec *specs.Spec) {
 	// No-op.
 }
+
+// startTimesMatch reports whether a process start time saved for a
+// container's PID matches the PID's current one (no PID reuse).
+func startTimesMatch(saved, current string, _ int) bool {
+	return saved == current
+}
diff --git a/internal/oci/container_freebsd_test.go b/internal/oci/container_freebsd_test.go
new file mode 100644
index 000000000..65761d500
--- /dev/null
+++ b/internal/oci/container_freebsd_test.go
@@ -0,0 +1,43 @@
+//go:build freebsd && cgo
+
+package oci
+
+import (
+	"fmt"
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestFreeBSDPidStartTime(t *testing.T) {
+	pid := os.Getpid()
+	st, err := getPidStartTime(pid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasPrefix(st, bootRelativePrefix) {
+		t.Fatalf("start time %q is not boot-relative", st)
+	}
+	again, err := getPidStartTime(pid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !startTimesMatch(st, again, pid) {
+		t.Errorf("start time not stable: %q vs %q", st, again)
+	}
+	// Containers created by older CRI-O versions saved the wall-clock time.
+	abs, _, err := kinfoStartTime(pid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	legacy := fmt.Sprintf("%d,%d", abs.Sec, abs.Usec)
+	if !startTimesMatch(legacy, again, pid) {
+		t.Errorf("legacy saved start time %q not accepted", legacy)
+	}
+	if startTimesMatch(bootRelativePrefix+"1,000000", again, pid) {
+		t.Errorf("a different start time matched")
+	}
+	if startTimesMatch("1,0", again, pid) {
+		t.Errorf("a different legacy start time matched")
+	}
+}
