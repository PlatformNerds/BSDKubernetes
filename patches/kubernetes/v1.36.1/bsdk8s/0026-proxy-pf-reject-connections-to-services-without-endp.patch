From 0cffaeba3911503648d35b9e7b826b6d37df7c77 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Tue, 17 Nov 2026 22:58:31 -0700
Subject: [PATCH 26/27] proxy/pf: reject connections to services without
 endpoints

A service without endpoints had its anchor flushed, so connections to
it timed out (or, from the node, left by the default route). Reject
them instead, as the iptables proxier does: block return (TCP RST, ICMP
unreachable) for the ClusterIP, NodePorts, externalIPs and LoadBalancer
IPs. With internalTrafficPolicy: Local and no local endpoint, while
other traffic still has endpoints, drop ClusterIP traffic, also as on
Linux.

Fixes the e2e tests "should be rejected when no endpoints exist" and
"should be rejected for evicted pods (no endpoints exist)".
---
 pkg/proxy/pf/proxier.go      | 36 +++++++++++++++++++++++++++---------
 pkg/proxy/pf/proxier_test.go | 33 +++++++++++++++++++++++++++++++++
 2 files changed, 60 insertions(+), 9 deletions(-)

diff --git a/pkg/proxy/pf/proxier.go b/pkg/proxy/pf/proxier.go
index 8d1c50aeff3..7fc4abe6aa4 100644
--- a/pkg/proxy/pf/proxier.go
+++ b/pkg/proxy/pf/proxier.go
@@ -510,6 +510,12 @@ type serviceRules struct {
 	shortCircuit *pfTarget
 }
 
+// noEndpoints reports whether no traffic to the service can reach an
+// endpoint (iptables: no locally reachable endpoints).
+func (r *serviceRules) noEndpoints() bool {
+	return r.internal == nil && r.external == nil && r.shortCircuit == nil
+}
+
 // writeServiceRules writes one service port's anchor: rdr for its ClusterIP
 // and NodePorts, nat for NodePort traffic to remote endpoints, and filter
 // rules for traffic the node itself sends to the ClusterIP or a NodePort.
@@ -518,6 +524,15 @@ type serviceRules struct {
 func (proxier *Proxier) writeServiceRules(r *serviceRules) {
 	af, proto := r.af, r.proto
 	dests := r.externalDestinations()
+	if r.noEndpoints() {
+		// Reject (TCP RST, ICMP unreachable) rather than let clients
+		// time out, as on Linux.
+		proxier.rejectRule(af, proto, r.clusterIP, r.port)
+		for _, d := range dests {
+			proxier.rejectRule(af, proto, d.ip, d.port)
+		}
+		return
+	}
 	for _, d := range dests {
 		if d.firewalled {
 			proxier.pfData.Write("table", lbSourceTable, "const", "{", strings.Join(r.lbSourceRanges, ", "), "}")
@@ -595,6 +610,11 @@ func (proxier *Proxier) writeServiceRules(r *serviceRules) {
 	}
 	if r.internal != nil {
 		proxier.hostRedirectRule(af, proto, "any", r.clusterIP, r.port, r.internal.hosts, r.internal.port)
+	} else {
+		// internalTrafficPolicy: Local and no local endpoint: drop,
+		// as on Linux, rather than send it to the default route.
+		proxier.pfData.Write("block drop quick", af, "proto", proto,
+			"from any to", r.clusterIP.String(), "port", strconv.Itoa(r.port))
 	}
 	for _, d := range dests {
 		if nodeTarget != nil {
@@ -624,6 +644,13 @@ func (proxier *Proxier) writeServiceRules(r *serviceRules) {
 	}
 }
 
+// rejectRule rejects connections to a service address and port, in both
+// directions: from pods and other hosts (in) and from the node itself (out).
+func (proxier *Proxier) rejectRule(af, proto string, ip net.IP, port int) {
+	proxier.pfData.Write("block return quick", af, "proto", proto,
+		"from any to", ip.String(), "port", strconv.Itoa(port))
+}
+
 // lbSourceTable is the anchor table of sources allowed to reach a Service's
 // LoadBalancer IPs.
 const lbSourceTable = "<lb_src>"
@@ -913,15 +940,6 @@ func (proxier *Proxier) syncProxyRules() error {
 				udpFronts[pfAddrPort(d.ip.String(), d.port)] = endpoints
 			}
 		}
-		if rules.internal == nil && rules.external == nil && rules.shortCircuit == nil {
-			// No endpoints (left): drop the rules that still redirect
-			// to the old ones.
-			if err := flushAnchor(proxier.exec, "cni-rdr/"+svcInfo.anchorName); err != nil {
-				klog.ErrorS(err, "Failed to flush rules of service without endpoints", "service", svcName)
-			}
-			continue
-		}
-
 		rules.af = "inet"
 		if proxier.ipFamily == v1.IPv6Protocol {
 			rules.af = "inet6"
diff --git a/pkg/proxy/pf/proxier_test.go b/pkg/proxy/pf/proxier_test.go
index 85f269dc02d..7feef562c63 100644
--- a/pkg/proxy/pf/proxier_test.go
+++ b/pkg/proxy/pf/proxier_test.go
@@ -274,3 +274,36 @@ func TestLBSourceRanges(t *testing.T) {
 		}
 	}
 }
+
+// No endpoints: connections to every address of the service are rejected.
+func TestWriteServiceRulesNoEndpoints(t *testing.T) {
+	p := &Proxier{pfData: proxyutil.NewLineBuffer(), nodeIP: net.ParseIP("192.168.100.1")}
+	p.writeServiceRules(&serviceRules{name: "ns/svc:dns", af: "inet", proto: "udp",
+		clusterIP: net.ParseIP("10.96.0.20"), port: 53, nodePort: 30053,
+		nodeIPs:     []net.IP{net.ParseIP("192.168.100.1")},
+		externalIPs: []net.IP{net.ParseIP("192.168.100.200")}})
+	want := "block return quick inet proto udp from any to 10.96.0.20 port 53\n" +
+		"block return quick inet proto udp from any to 192.168.100.1 port 30053\n" +
+		"block return quick inet proto udp from any to 192.168.100.200 port 53\n"
+	if got := p.pfData.String(); got != want {
+		t.Errorf("got\n%s\nwant\n%s", got, want)
+	}
+}
+
+// internalTrafficPolicy: Local without a local endpoint, but NodePort
+// traffic still has endpoints: ClusterIP traffic is dropped.
+func TestWriteServiceRulesInternalLocalNoLocalEndpoint(t *testing.T) {
+	p := &Proxier{pfData: proxyutil.NewLineBuffer(), nodeIP: net.ParseIP("192.168.100.1")}
+	remote := target(nil, []string{"10.244.1.7"}, 8080)
+	p.writeServiceRules(&serviceRules{name: "ns/svc:http", af: "inet", proto: "tcp",
+		clusterIP: net.ParseIP("10.96.0.20"), port: 80, nodePort: 30080,
+		nodeIPs: []net.IP{net.ParseIP("192.168.100.1")}, external: remote})
+	want := "rdr inet proto tcp from any to 192.168.100.1 port 30080 tag KUBE_NODEPORT -> { 10.244.1.7 } port 8080 round-robin\n" +
+		"nat inet proto tcp from any to { 10.244.1.7 } port 8080 tagged KUBE_NODEPORT -> 192.168.100.1\n" +
+		"block drop quick inet proto tcp from any to 10.96.0.20 port 80\n" +
+		"pass out quick on lo0 inet proto tcp from any to 192.168.100.1 port 30080 rdr-to { 10.244.1.7 } port 8080 round-robin\n"
+	if got := p.pfData.String(); got != want {
+		t.Errorf("got\n%s\nwant\n%s", got, want)
+	}
+	checkOrder(t, p.pfData.String())
+}
