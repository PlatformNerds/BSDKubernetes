From 0d325bfb09d71d8dc57e5718c18ff046a259a275 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Sat, 21 Nov 2026 08:15:03 -0700
Subject: [PATCH 27/27] freebsd: give allow.mknod to containers with CAP_MKNOD

On Linux it's CAP_MKNOD, not privilege, that lets a container create
device nodes: containerd's default capabilities include it, CRI-O's don't.
Set allow.mknod on a container jail when the container is privileged or
ends up with MKNOD (defaults + added - dropped, as for NET_RAW, now one
hasCapability helper). The sandbox jail always gets it when the kernel
knows it: a child jail can't have a permission its parent lacks, which
containers will have the capability isn't known yet, and the sandbox only
runs pause.
---
 .../factory/container/namespaces_freebsd.go   |  5 ----
 internal/jailparam/jailparam_freebsd.go       | 21 ++++++++++++-----
 server/container_create_freebsd.go            | 23 ++++++++++++-------
 server/sandbox_run_freebsd.go                 |  6 ++---
 4 files changed, 33 insertions(+), 22 deletions(-)

diff --git a/internal/factory/container/namespaces_freebsd.go b/internal/factory/container/namespaces_freebsd.go
index 80922d614..733029d90 100644
--- a/internal/factory/container/namespaces_freebsd.go
+++ b/internal/factory/container/namespaces_freebsd.go
@@ -30,11 +30,6 @@ func (c *container) SpecAddNamespaces(sb SandboxIFace, targetCtr *oci.Container,
 	if jailparam.PodNFSDAllowed(hostNetwork, c.Privileged()) {
 		c.Spec().AddAnnotation(jailparam.AllowNFSDAnnotation, "true")
 	}
-	// Privileged containers may create device nodes outside devfs; the
-	// sandbox jail got the same permission.
-	if jailparam.MknodAllowed(c.Privileged()) {
-		c.Spec().AddAnnotation(jailparam.AllowMknodAnnotation, "true")
-	}
 
 	return nil
 }
diff --git a/internal/jailparam/jailparam_freebsd.go b/internal/jailparam/jailparam_freebsd.go
index 3e63f7a3e..26fd5939c 100644
--- a/internal/jailparam/jailparam_freebsd.go
+++ b/internal/jailparam/jailparam_freebsd.go
@@ -43,10 +43,19 @@ func PodNFSDAllowed(hostNetwork, privileged bool) bool {
 // the jail may create device nodes outside devfs (freebsd-src patch 0043).
 const AllowMknodAnnotation = "org.freebsd.jail.allow.mknod"
 
-// MknodAllowed reports whether a privileged jail should get allow.mknod, as a
-// privileged Linux container has CAP_MKNOD (e.g. tools that prepare device
-// nodes in a volume). It grants no device access: on FreeBSD a device is
-// reached only through devfs, where a jail can't create nodes.
-func MknodAllowed(privileged bool) bool {
-	return privileged && Supported("allow.mknod")
+// MknodAllowed reports whether a container jail should get allow.mknod: the
+// container is privileged or has CAP_MKNOD, which lets a Linux container
+// create device nodes (e.g. tools that prepare device nodes in a volume). It
+// grants no device access: on FreeBSD a device is reached only through
+// devfs, where a jail can't create nodes.
+func MknodAllowed(privileged, capMknod bool) bool {
+	return (privileged || capMknod) && Supported("allow.mknod")
+}
+
+// SandboxMknodAllowed reports whether a pod's sandbox jail should get
+// allow.mknod. A child jail can't have a permission its parent lacks, and
+// which containers will have CAP_MKNOD isn't known yet; the sandbox jail
+// only runs the pause process.
+func SandboxMknodAllowed() bool {
+	return Supported("allow.mknod")
 }
diff --git a/server/container_create_freebsd.go b/server/container_create_freebsd.go
index 75fbc5800..8bab3a56f 100644
--- a/server/container_create_freebsd.go
+++ b/server/container_create_freebsd.go
@@ -16,6 +16,7 @@ import (
 	crierrors "k8s.io/cri-api/pkg/errors"
 
 	"github.com/cri-o/cri-o/internal/config/device"
+	"github.com/cri-o/cri-o/internal/jailparam"
 	ctrfactory "github.com/cri-o/cri-o/internal/factory/container"
 	"github.com/cri-o/cri-o/internal/lib/sandbox"
 	"github.com/cri-o/cri-o/internal/log"
@@ -347,20 +348,26 @@ func (s *Server) specSetDevices(ctr ctrfactory.Container, sb *sandbox.Sandbox) e
 	// which the default devfs ruleset hides; a vnet jail's bpf only sees the
 	// pod's own interfaces. Raw IP sockets are already allowed for all pods
 	// (allow.raw_sockets), as Linux's default capabilities don't allow them.
-	if !ctr.Privileged() && netRawCapability(ctr.Config().GetLinux().GetSecurityContext().GetCapabilities(), s.config.DefaultCapabilities) {
+	caps := ctr.Config().GetLinux().GetSecurityContext().GetCapabilities()
+	if !ctr.Privileged() && hasCapability(caps, s.config.DefaultCapabilities, "NET_RAW") {
 		for i, m := range ctr.Spec().Config.Mounts {
 			if m.Type == "devfs" && filepath.Clean(m.Destination) == "/dev" {
 				ctr.Spec().Config.Mounts[i].Options = append(m.Options, "rule=path bpf* unhide")
 			}
 		}
 	}
+	// CAP_MKNOD lets a Linux container create device nodes; allow.mknod
+	// lets a jail create them outside devfs, where they are inert.
+	if jailparam.MknodAllowed(ctr.Privileged(), hasCapability(caps, s.config.DefaultCapabilities, "MKNOD")) {
+		ctr.Spec().AddAnnotation(jailparam.AllowMknodAnnotation, "true")
+	}
 	return nil
 }
 
-// netRawCapability reports whether the container ends up with CAP_NET_RAW,
-// the way SpecSetupCapabilities computes it: the defaults, plus the
-// capabilities the container adds, minus those it drops.
-func netRawCapability(caps *types.Capability, defaults []string) bool {
+// hasCapability reports whether the container ends up with the capability
+// name (e.g. "NET_RAW"), the way SpecSetupCapabilities computes it: the
+// defaults, plus the capabilities the container adds, minus those it drops.
+func hasCapability(caps *types.Capability, defaults []string, name string) bool {
 	has := func(list []string, name string) bool {
 		for _, c := range list {
 			if strings.EqualFold(strings.TrimPrefix(strings.ToUpper(c), "CAP_"), name) {
@@ -369,14 +376,14 @@ func netRawCapability(caps *types.Capability, defaults []string) bool {
 		}
 		return false
 	}
-	if has(caps.GetDropCapabilities(), "NET_RAW") {
+	if has(caps.GetDropCapabilities(), name) {
 		return false
 	}
-	if has(caps.GetAddCapabilities(), "NET_RAW") || has(caps.GetAddCapabilities(), "ALL") {
+	if has(caps.GetAddCapabilities(), name) || has(caps.GetAddCapabilities(), "ALL") {
 		return true
 	}
 	if has(caps.GetDropCapabilities(), "ALL") {
 		return false
 	}
-	return has(defaults, "NET_RAW")
+	return has(defaults, name)
 }
diff --git a/server/sandbox_run_freebsd.go b/server/sandbox_run_freebsd.go
index 67a0491ac..a95a96141 100644
--- a/server/sandbox_run_freebsd.go
+++ b/server/sandbox_run_freebsd.go
@@ -384,9 +384,9 @@ func (s *Server) runPodSandbox(ctx context.Context, req *types.RunPodSandboxRequ
 	if jailparam.PodNFSDAllowed(hostNetwork, req.GetConfig().GetLinux().GetSecurityContext().GetPrivileged()) {
 		g.AddAnnotation(jailparam.AllowNFSDAnnotation, "true")
 	}
-	// A privileged pod may create device nodes outside devfs (allow.mknod),
-	// like CAP_MKNOD on Linux; the sandbox jail needs it too.
-	if jailparam.MknodAllowed(req.GetConfig().GetLinux().GetSecurityContext().GetPrivileged()) {
+	// Containers with CAP_MKNOD may create device nodes outside devfs
+	// (allow.mknod); the sandbox jail needs the permission for them to have it.
+	if jailparam.SandboxMknodAllowed() {
 		g.AddAnnotation(jailparam.AllowMknodAnnotation, "true")
 	}
 	// We want to cleanup after ourselves if we are managing any namespaces and fail in this function.
