From f8570653931617fb8a7066b1e64c1684c1daf678 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Sun, 15 Nov 2026 23:01:40 -0700
Subject: [PATCH] linux: accept EPOLLEXCLUSIVE in epoll_ctl(2)

EPOLLEXCLUSIVE asks to wake only one of several epoll instances waiting
for the same file, to avoid a thundering herd on a listening socket shared
by worker processes. epoll_ctl() rejected it with EINVAL ('epoll_ctl
unsupported flags: 0x10000001'), so nginx's worker processes exited at
startup ('worker process exited with fatal code 2 and cannot be
respawned') whenever it ran more than one: the stock nginx container
images run one per CPU.

Accept it with EPOLL_CTL_ADD and register the event normally: every epoll
instance is woken, which is correct but slower, as the others find
nothing to accept. Like Linux, reject it with EPOLL_CTL_MOD and with
EPOLLONESHOT.

Tested on 15.1 arm64 with the official nginx:1.27-alpine image (8 workers)
in a jail: serves requests; before, all workers exited.
---
 sys/compat/linux/linux_event.c | 20 ++++++++++++++++++++
 sys/compat/linux/linux_event.h |  1 +
 2 files changed, 21 insertions(+)

diff --git a/sys/compat/linux/linux_event.c b/sys/compat/linux/linux_event.c
index fc3ef7c3e..add7d2b4e 100644
--- a/sys/compat/linux/linux_event.c
+++ b/sys/compat/linux/linux_event.c
@@ -322,6 +322,26 @@ linux_epoll_ctl(struct thread *td, struct linux_epoll_ctl_args *args)
 
 	ciargs.changelist = kev;
 
+	/*
+	 * EPOLLEXCLUSIVE asks to wake only one of several epoll instances
+	 * waiting for the same file (e.g. one listening socket polled by
+	 * every worker process of nginx), to avoid a thundering herd.  Every
+	 * instance is woken here instead, which is correct but slower: the
+	 * others find nothing to do (accept(2) on a non-blocking socket
+	 * returns EAGAIN).  Like Linux, it is only accepted with
+	 * EPOLL_CTL_ADD and not with EPOLLONESHOT.  Rejecting it made nginx's
+	 * worker processes exit at startup.
+	 */
+	if (args->op != LINUX_EPOLL_CTL_DEL &&
+	    (le.events & LINUX_EPOLLEXCLUSIVE) != 0) {
+		if (args->op != LINUX_EPOLL_CTL_ADD ||
+		    (le.events & LINUX_EPOLLONESHOT) != 0) {
+			error = EINVAL;
+			goto leave0;
+		}
+		le.events &= ~LINUX_EPOLLEXCLUSIVE;
+	}
+
 	if (args->op != LINUX_EPOLL_CTL_DEL) {
 		error = epoll_to_kevent(td, args->fd, &le, kev, &nchanges);
 		if (error != 0)
diff --git a/sys/compat/linux/linux_event.h b/sys/compat/linux/linux_event.h
index 8c6758fef..c86ccac87 100644
--- a/sys/compat/linux/linux_event.h
+++ b/sys/compat/linux/linux_event.h
@@ -38,6 +38,7 @@
 #define	LINUX_EPOLLERR		0x008
 #define	LINUX_EPOLLHUP		0x010
 #define	LINUX_EPOLLRDHUP	0x2000
+#define	LINUX_EPOLLEXCLUSIVE	(1u<<28)
 #define	LINUX_EPOLLWAKEUP	1u<<29
 #define	LINUX_EPOLLONESHOT	1u<<30
 #define	LINUX_EPOLLET		1u<<31
