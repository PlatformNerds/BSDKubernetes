+
+package server
+
+import (
+	"fmt"
+	"io/ioutil"
+	"os"
+	"os/exec"
+
+	"github.com/golang/glog"
+	"github.com/kubernetes-sigs/nfs-ganesha-server-and-external-provisioner/pkg/volume"
+)
+
+// On FreeBSD the server is unfs3 (see pkg/volume/export_unfs3_freebsd.go).
+// The Ganesha arguments keep their meaning where one exists: the config file
+// is unfsd's exports file and the log is where unfsd's output goes. Grace
+// period and fsid settings are Ganesha's and have no unfs3 equivalent.
+
+const rpcbindSocket = "/var/run/rpcbind.sock"
+
+// Setup starts rpcbind, with which unfsd registers, and creates an empty
+// exports file if there is none.
+func Setup(config string, gracePeriod uint, fsidDevice bool) error {
+	// rpcbind is running if its socket exists. (rpcinfo 127.0.0.1 retries
+	// for minutes when nothing listens.) rpcbind daemonizes; it gets no
+	// output pipes, which its child would hold open.
+	if _, err := os.Stat(rpcbindSocket); err != nil {
+		if err := exec.Command("/usr/sbin/rpcbind").Run(); err != nil {
+			return fmt.Errorf("starting rpcbind failed with error: %v", err)
+		}
+	}
+	if _, err := os.Stat(config); os.IsNotExist(err) {
+		if err := ioutil.WriteFile(config, []byte("# unfsd exports, written by nfs-provisioner\n"), 0600); err != nil {
+			return fmt.Errorf("error writing exports file %s: %v", config, err)
+		}
+	}
+	return nil
+}
+
+// Run runs unfsd in the foreground until it exits. MOUNT is served on 20048,
+// the port Ganesha uses, NFS on 2049.
+func Run(log, pid, config string) error {
+	glog.Infof("Running NFS server!")
+	cmd := exec.Command("/usr/local/sbin/unfsd", "-d", "-e", config, "-i", volume.UnfsPidFile, "-n", "2049", "-m", "20048")
+	f, err := os.OpenFile(log, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0644)
+	if err == nil {
+		defer f.Close()
+		cmd.Stdout, cmd.Stderr = f, f
+	}
+	if err := cmd.Run(); err != nil {
+		return fmt.Errorf("unfsd failed with error: %v", err)
+	}
+	return nil
+}
+
+// Stop stops the NFS server.
+func Stop() {
+}
