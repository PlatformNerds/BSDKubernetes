From edf7be819240b65fd16808e216d17f89a3b849eb Mon Sep 17 00:00:00 2001
From: Doug Rabson <dfr@rabson.org>
Date: Sat, 18 Jul 2026 14:55:33 +0100
Subject: [PATCH 12/12] Add support for AtomicWriter.lchown on FreeBSD

---
 pkg/volume/util/atomic_writer_freebsd.go     | 27 ++++++++++++++++++++
 pkg/volume/util/atomic_writer_unsupported.go |  2 +-
 2 files changed, 28 insertions(+), 1 deletion(-)
 create mode 100644 pkg/volume/util/atomic_writer_freebsd.go

diff --git a/pkg/volume/util/atomic_writer_freebsd.go b/pkg/volume/util/atomic_writer_freebsd.go
new file mode 100644
index 00000000000..55f11c28cd2
--- /dev/null
+++ b/pkg/volume/util/atomic_writer_freebsd.go
@@ -0,0 +1,27 @@
+//go:build freebsd
+
+/*
+Copyright 2024 The Kubernetes Authors.
+
