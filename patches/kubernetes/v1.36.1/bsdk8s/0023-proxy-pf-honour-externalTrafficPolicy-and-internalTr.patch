+				}
+			}
 		}
 	}
-	if nodePort != 0 {
-		for _, ip := range nodeIPs {
+	// With externalTrafficPolicy: Local, the node's own NodePort
+	// connections short-circuit to all endpoints.
+	nodeTarget := r.external
