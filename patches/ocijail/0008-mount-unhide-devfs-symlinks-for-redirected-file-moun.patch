From e3bbd8327ec11460a5d799bb12cfbf58162efe8d Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Sat, 14 Nov 2026 10:00:08 -0700
Subject: [PATCH 8/8] mount: unhide devfs symlinks for redirected file mounts

Container /dev is normally mounted with a ruleset that hides every node
not explicitly unhidden (CRI-O and podman use ruleset 4,
devfsrules_jail), and that also hides the symlink created for a file
mount below /dev, so writes still failed with 'Operation not supported'.
Unhide each symlink with 'devfs rule apply path <name> unhide'.

The test now mounts /dev with ruleset=4 like CRI-O does (it fails without
this change) and always deletes the container before removing its root.
---
 ocijail/mount.cpp | 17 ++++++++++++-----
 test/run_test.py  | 16 +++++++++++-----
 2 files changed, 23 insertions(+), 10 deletions(-)

diff --git a/ocijail/mount.cpp b/ocijail/mount.cpp
index 4313bef..e794cc3 100644
--- a/ocijail/mount.cpp
+++ b/ocijail/mount.cpp
@@ -6,6 +6,7 @@
 #include <sys/wait.h>
 #include <iostream>
 #include <optional>
+#include <tuple>
 
 #include "ocijail/main.h"
 #include "ocijail/mount.h"
@@ -522,7 +523,7 @@ static bool is_file_bind_mount(const json& mount) {
 
 static json redirect_devfs_file_mounts(
     const json& mounts,
-    std::vector<std::pair<fs::path, fs::path>>* links = nullptr) {
+    std::vector<std::tuple<fs::path, fs::path, fs::path>>* links = nullptr) {
     if (!mounts.is_array()) {
         return mounts;
     }
@@ -553,7 +554,7 @@ static json redirect_devfs_file_mounts(
             auto redirected = devfiles_dir / flat;
             m["destination"] = redirected.string();
             if (links) {
-                links->emplace_back(dest, redirected);
+                links->emplace_back(dest, redirected, dev);
             }
             break;
         }
@@ -566,7 +567,7 @@ void mount_volumes(main_app& app,
                    const fs::path& root_path,
                    bool prepare_only,
                    const json& config_mounts) {
-    std::vector<std::pair<fs::path, fs::path>> devfs_links;
+    std::vector<std::tuple<fs::path, fs::path, fs::path>> devfs_links;
     const json mounts = redirect_devfs_file_mounts(config_mounts, &devfs_links);
     bool file_mount_supported = true;
     std::size_t mounted = 0;
@@ -589,14 +590,20 @@ void mount_volumes(main_app& app,
             mounted++;
         }
         // Now that the devfs is mounted, link the redirected file mounts
-        // into it.
+        // into it. The devfs usually has a ruleset that hides everything
+        // not explicitly unhidden (e.g. devfsrules_jail), which also hides
+        // new symlinks, so unhide each one.
         if (!prepare_only) {
-            for (auto& [dest, target] : devfs_links) {
+            for (auto& [dest, target, devdir] : devfs_links) {
                 auto link = root_path / dest.relative_path();
                 if (fs::is_symlink(link)) {
                     fs::remove(link);
                 }
                 fs::create_symlink(target, link);
+                apply_devfs_rule(root_path / devdir.relative_path(),
+                                 "path " +
+                                     dest.lexically_relative(devdir).string() +
+                                     " unhide");
             }
         }
     } catch (const std::exception& e) {
diff --git a/test/run_test.py b/test/run_test.py
index e56dc1f..8391028 100644
--- a/test/run_test.py
+++ b/test/run_test.py
@@ -276,17 +276,23 @@ class test_run(unittest.TestCase):
             c = self.config()
             c["root"]["path"] = root_dir
             c["mounts"] = [
-                {"destination": "/dev", "type": "devfs", "source": "devfs"},
+                # ruleset 4 (devfsrules_jail) hides everything not
+                # unhidden, as CRI-O and podman use for containers
+                {"destination": "/dev", "type": "devfs", "source": "devfs",
+                 "options": ["ruleset=4"]},
                 {"destination": "/dev/termination-custom-log",
                  "type": "nullfs", "source": msg.name},
             ]
             c["process"]["args"] = [
                 "sh", "-c", "echo -n DONE > /dev/termination-custom-log"]
             c["process"]["env"] = ["PATH=/rescue"]
-            ret, _, _ = self.run_with_config(c)
-            self.assertEqual(ret, 0)
-            self.assertEqual(msg.read(), "DONE")
-            self.delete()
+            try:
+                ret, _, _ = self.run_with_config(c)
+                self.assertEqual(ret, 0)
+                self.assertEqual(msg.read(), "DONE")
+            finally:
+                # unmount (devfs, file mount) before root_dir is removed
+                self.delete(False)
             # nothing left behind in the container root
             self.assertFalse(
                 os.path.exists(os.path.join(root_dir, ".ocijail-devfiles")))
