From 75d793fac3ee4bb4aca1ec3c1656187577110f1d Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Sun, 22 Nov 2026 18:57:25 -0700
Subject: [PATCH] crio: reopen the --log file on SIGHUP

The log file was opened once, so newsyslog(8) or logrotate could only
rotate it by restarting CRI-O (it reached 160 MB on the test nodes).
SIGHUP already reloads the configuration; also reopen the log file then,
and close the old one after logrus switched to the new file.
---
 cmd/crio/main.go | 29 ++++++++++++++++++++++++++++-
 1 file changed, 28 insertions(+), 1 deletion(-)

diff --git a/cmd/crio/main.go b/cmd/crio/main.go
index f3bdf5d12..dbc5c3740 100644
--- a/cmd/crio/main.go
+++ b/cmd/crio/main.go
@@ -123,6 +123,32 @@ or does not point to a mount namespace bindmount, CRI-O will run in its
 parent's mount namespace and log a warning that the requested namespace
 was not joined.`
 
+func openLogFile(path string) (*os.File, error) {
+	return os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_APPEND|os.O_SYNC, 0o666)
+}
+
+// reopenLogOnHup reopens the --log file on SIGHUP, so that newsyslog(8) or
+// logrotate can rotate it (SIGHUP also reloads the configuration).
+func reopenLogOnHup(path string, f *os.File) {
+	ch := make(chan os.Signal, 1)
+	signal.Notify(ch, signals.Hup)
+
+	go func() {
+		for range ch {
+			nf, err := openLogFile(path)
+			if err != nil {
+				logrus.Errorf("Unable to reopen log file %s: %v", path, err)
+
+				continue
+			}
+
+			logrus.SetOutput(nf)
+			f.Close()
+			f = nf
+		}
+	}()
+}
+
 func main() {
 	log.InitKlogShim()
 
@@ -208,12 +234,13 @@ func main() {
 		logrus.AddHook(filterHook)
 
 		if path := c.String("log"); path != "" {
-			f, err := os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_APPEND|os.O_SYNC, 0o666)
+			f, err := openLogFile(path)
 			if err != nil {
 				return err
 			}
 
 			logrus.SetOutput(f)
+			reopenLogOnHup(path, f)
 		}
 
 		switch c.String("log-format") {
