From 964f85031800400a8d84b5be9f195f63fc746e06 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Wed, 18 Nov 2026 19:59:44 -0700
Subject: [PATCH] regression-issue-74839: read TCP through bpf(4) on FreeBSD

The server watches the client's TCP segments to forge an out-of-window
one. On Linux a raw ip:tcp socket gets a copy of every TCP packet;
FreeBSD never delivers TCP to raw sockets, so the server never saw the
handshake and the test failed without testing anything. On FreeBSD, read
the segments from bpf(4) on the interface that holds the pod IP (only
received packets, IPv4/TCP to that IP) and keep writing through the raw
socket. The pod already asks for CAP_NET_RAW.
---
 test/images/regression-issue-74839/main.go    |  11 +-
 .../regression-issue-74839/sniff_freebsd.go   | 120 ++++++++++++++++++
 .../regression-issue-74839/sniff_other.go     |  27 ++++
 3 files changed, 157 insertions(+), 1 deletion(-)
 create mode 100644 test/images/regression-issue-74839/sniff_freebsd.go
 create mode 100644 test/images/regression-issue-74839/sniff_other.go

diff --git a/test/images/regression-issue-74839/main.go b/test/images/regression-issue-74839/main.go
index 5cf749caeca..cfed5a3bcc9 100644
--- a/test/images/regression-issue-74839/main.go
+++ b/test/images/regression-issue-74839/main.go
@@ -64,6 +64,11 @@ func main() {
 	}
 }
 
+// packetReader reads TCP segments the way a raw ip:tcp socket does.
+type packetReader interface {
+	ReadFrom(b []byte) (int, net.Addr, error)
+}
+
 func probe(ip string) {
 	log.Printf("probing %v", ip)
 
@@ -76,12 +81,16 @@ func probe(ip string) {
 	if err != nil {
 		panic(err)
 	}
+	rd, err := newSniffer(conn, ipAddr.IP)
+	if err != nil {
+		panic(err)
+	}
 
 	pending := make(map[string]uint32)
 
 	var buffer [4096]byte
 	for {
-		n, addr, err := conn.ReadFrom(buffer[:])
+		n, addr, err := rd.ReadFrom(buffer[:])
 		if err != nil {
 			log.Printf("conn.ReadFrom() error: %v", err)
 			continue
diff --git a/test/images/regression-issue-74839/sniff_freebsd.go b/test/images/regression-issue-74839/sniff_freebsd.go
new file mode 100644
index 00000000000..8cd82c6983a
--- /dev/null
+++ b/test/images/regression-issue-74839/sniff_freebsd.go
@@ -0,0 +1,120 @@
+//go:build freebsd
+
