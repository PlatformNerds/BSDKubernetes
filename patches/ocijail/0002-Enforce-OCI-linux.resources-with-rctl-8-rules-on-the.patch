diff --git a/ocijail/rctl.cpp b/ocijail/rctl.cpp
new file mode 100644
index 0000000..d975c53
--- /dev/null
+++ b/ocijail/rctl.cpp
@@ -0,0 +1,90 @@
+#include "ocijail/rctl.h"
+
+#include <sys/types.h>
+#include <sys/rctl.h>
+
+#include <cerrno>
+#include <cstdint>
+#include <system_error>
+
+using nlohmann::json;
+
+namespace ocijail::rctl {
+
+namespace {
+
+// Returns the value of an integer field if present, non-null and > 0.
+std::optional<std::int64_t> positive(const json& obj, const char* key) {
+    if (!obj.is_object() || !obj.contains(key) || !obj[key].is_number_integer()) {
+        return std::nullopt;
+    }
+    auto v = obj[key].get<std::int64_t>();
+    if (v <= 0) {
+        return std::nullopt;
+    }
+    return v;
+}
+
+}  // namespace
+
+translation from_oci_resources(const json& resources) {
+    translation t;
+    if (!resources.is_object()) {
+        return t;
+    }
+
+    if (resources.contains("memory")) {
+        if (auto limit = positive(resources["memory"], "limit")) {
+            t.rules.push_back("memoryuse:sigkill=" + std::to_string(*limit));
+        }
+    }
+
+    if (resources.contains("cpu")) {
+        const auto& cpu = resources["cpu"];
+        auto quota = positive(cpu, "quota");
+        auto period = positive(cpu, "period");
+        if (quota && period) {
+            // percent of one CPU, rounded up, at least 1
+            auto pct = (*quota * 100 + *period - 1) / *period;
+            t.rules.push_back("pcpu:deny=" + std::to_string(pct < 1 ? 1 : pct));
+        }
+        if (positive(cpu, "shares")) {
+            t.ignored.push_back("cpu.shares");
+        }
+    }
+
+    if (resources.contains("pids")) {
+        if (auto limit = positive(resources["pids"], "limit")) {
+            t.rules.push_back("maxproc:deny=" + std::to_string(*limit));
+        }
+    }
+
+    return t;
+}
+
+bool apply(const std::string& jail_name, const std::vector<std::string>& rules) {
+    for (const auto& r : rules) {
+        auto rule = "jail:" + jail_name + ":" + r;
+        if (::rctl_add_rule(rule.c_str(), rule.size() + 1, nullptr, 0) < 0) {
+            if (errno == ENOSYS) {
+                return false;  // RACCT disabled (kern.racct.enable=0)
+            }
+            throw std::system_error(
+                errno, std::system_category(), "rctl_add_rule " + rule);
+        }
+    }
+    return true;
+}
+
+void remove(const std::string& jail_name) {
+    auto filter = "jail:" + jail_name;
+    if (::rctl_remove_rule(filter.c_str(), filter.size() + 1, nullptr, 0) < 0) {
+        if (errno == ENOSYS || errno == ESRCH) {
+            return;
+        }
+        throw std::system_error(
+            errno, std::system_category(), "rctl_remove_rule " + filter);
+    }
+}
+
+}  // namespace ocijail::rctl
diff --git a/ocijail/rctl.h b/ocijail/rctl.h
new file mode 100644
index 0000000..44cf1ee
--- /dev/null
+++ b/ocijail/rctl.h
@@ -0,0 +1,50 @@
+#pragma once
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "nlohmann/json.hpp"
+
+namespace ocijail::rctl {
+
+// Translate the OCI "linux.resources" object (as generated by CRI-O, podman
+// and containerd from CRI/CLI resource settings) into FreeBSD rctl(8) rule
+// fragments of the form "<resource>:<action>=<amount>". Pure function, no
+// syscalls, so it can be unit tested.
+//
+//   memory.limit          -> memoryuse:sigkill: processes of the jail are
+//                            killed when its resident memory exceeds the
+//                            limit (closest match to Linux memory.max + OOM
+//                            kill). Checked by racctd once per second, so a
+//                            fast allocator can overshoot briefly.
+//                            Deliberately NOT swapuse:deny: it charges
+//                            writable anonymous mappings at mmap time, so Go
+//                            (heap arena map), the JVM and other reserving
+//                            allocators fail at startup with modest limits;
+//                            and NOT memoryuse:deny: it only triggers
+//                            reclaim and does nothing on hosts without swap.
+//   cpu.quota/cpu.period  -> pcpu:deny=ceil(100*quota/period) (percent of one
+//                            CPU, enforced by racct by suspending the jail's
+//                            processes: coarse, ~1s granularity)
+//   pids.limit            -> maxproc:deny
+//
+// cpu.shares has no FreeBSD equivalent (no proportional/group scheduling) and
+// is reported in `ignored`.
+struct translation {
+    std::vector<std::string> rules;
+    std::vector<std::string> ignored;
+};
+translation from_oci_resources(const nlohmann::json& resources);
+
+// Add "jail:<jail_name>:<rule>" for each rule. Returns false (and adds
+// nothing) if RACCT/RCTL is unavailable (kern.racct.enable=0 -> ENOSYS);
+// throws on any other error.
+bool apply(const std::string& jail_name, const std::vector<std::string>& rules);
+
+// Remove every rule whose subject is jail:<jail_name>. rctl rules are keyed
+// by jail *name* and outlive the jail, so this must run on delete. Missing
+// RACCT or "no matching rule" are not errors.
+void remove(const std::string& jail_name);
+
+}  // namespace ocijail::rctl
diff --git a/ocijail/rctl_test.cpp b/ocijail/rctl_test.cpp
new file mode 100644
index 0000000..176360d
--- /dev/null
+++ b/ocijail/rctl_test.cpp
@@ -0,0 +1,45 @@
+// Unit tests for rctl::from_oci_resources (pure translation, no syscalls).
+#include <cassert>
+#include <cstdlib>
+#include <iostream>
+
+#include "ocijail/rctl.h"
+
+using nlohmann::json;
+using ocijail::rctl::from_oci_resources;
+
+static void expect(const json& res, std::vector<std::string> rules,
+                   std::vector<std::string> ignored = {}) {
+    auto t = from_oci_resources(res);
+    if (t.rules != rules || t.ignored != ignored) {
+        std::cerr << "FAIL for " << res.dump() << "\n  got rules:";
+        for (auto& r : t.rules) std::cerr << " " << r;
+        std::cerr << "\n";
+        std::exit(1);
+    }
+}
+
+int main() {
+    // nothing / not an object / empty
+    expect(json(), {});
+    expect(json::object(), {});
+    // kubelet: limits {memory: 64Mi, cpu: 200m}, requests -> shares
+    expect(json::parse(R"({"memory":{"limit":67108864},
+                           "cpu":{"quota":20000,"period":100000,"shares":204}})"),
+           {"memoryuse:sigkill=67108864", "pcpu:deny=20"},
+           {"cpu.shares"});
+    // >1 CPU and rounding up: 1.5 CPU, 333m
+    expect(json::parse(R"({"cpu":{"quota":150000,"period":100000}})"), {"pcpu:deny=150"});
+    expect(json::parse(R"({"cpu":{"quota":33300,"period":100000}})"), {"pcpu:deny=34"});
+    // tiny quota still at least 1%
+    expect(json::parse(R"({"cpu":{"quota":1,"period":100000}})"), {"pcpu:deny=1"});
+    // unlimited markers are ignored: quota -1, limit 0, missing period
+    expect(json::parse(R"({"cpu":{"quota":-1,"period":100000},"memory":{"limit":0}})"), {});
+    expect(json::parse(R"({"cpu":{"quota":50000}})"), {});
+    // pids
+    expect(json::parse(R"({"pids":{"limit":4096}})"), {"maxproc:deny=4096"});
+    // wrong types are ignored rather than crashing
+    expect(json::parse(R"({"memory":{"limit":"64Mi"},"pids":{"limit":null}})"), {});
+    std::cout << "rctl_test: all passed\n";
+    return 0;
+}
