From 4d0c5f50a0aeb49b459e9f1ac4444c34ef0c5815 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Sun, 22 Nov 2026 23:36:02 -0700
Subject: [PATCH] proxy/pf: each IP family's proxier watches only its own
 anchors

The anchor list holds both families' Service anchors (kube-svc-v4-*,
kube-svc-v6-*), so with the dual-stack proxier both families resynced
when either family's rules were removed. Keep and compare only the
proxier's own family's anchors.
---
 pkg/proxy/pf/proxier.go      | 16 ++++++++++++++--
 pkg/proxy/pf/proxier_test.go | 11 +++++++++++
 2 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/pkg/proxy/pf/proxier.go b/pkg/proxy/pf/proxier.go
index 97daec26b98..33a10ef92fc 100644
--- a/pkg/proxy/pf/proxier.go
+++ b/pkg/proxy/pf/proxier.go
@@ -267,6 +267,18 @@ func listServiceAnchors(exec utilexec.Interface) (sets.Set[string], error) {
 	return parseServiceAnchors(string(out)), nil
 }
 
+// familyAnchors returns the anchors of this proxier's IP family (anchorName).
+func (proxier *Proxier) familyAnchors(anchors sets.Set[string]) sets.Set[string] {
+	prefix := "cni-rdr/" + anchorName("", "", proxier.ipFamily)[:len("kube-svc-v4-")]
+	own := sets.New[string]()
+	for a := range anchors {
+		if strings.HasPrefix(a, prefix) {
+			own.Insert(a)
+		}
+	}
+	return own
+}
+
 func parseServiceAnchors(out string) sets.Set[string] {
 	anchors := sets.New[string]()
 	for _, anchor := range strings.Split(out, "\n") {
@@ -320,7 +332,7 @@ func (proxier *Proxier) checkAnchors() {
 		proxier.logger.V(2).Info("Listing PF anchors failed", "err", err)
 		return
 	}
-	if missing := synced.Difference(current); missing.Len() > 0 {
+	if missing := synced.Difference(proxier.familyAnchors(current)); missing.Len() > 0 {
 		proxier.logger.Info("PF rules of Services were removed, resyncing", "anchors", missing.Len())
 		proxier.mu.Lock()
 		proxier.needFullSync = true
@@ -1177,7 +1189,7 @@ func (proxier *Proxier) syncProxyRules() error {
 		}
 	}
 	if anchors, err := listServiceAnchors(proxier.exec); err == nil {
-		proxier.syncedAnchors = anchors
+		proxier.syncedAnchors = proxier.familyAnchors(anchors)
 	} else {
 		proxier.logger.V(2).Info("Listing PF anchors failed", "err", err)
 	}
diff --git a/pkg/proxy/pf/proxier_test.go b/pkg/proxy/pf/proxier_test.go
index bf3040de100..853a7e58d72 100644
--- a/pkg/proxy/pf/proxier_test.go
+++ b/pkg/proxy/pf/proxier_test.go
@@ -22,6 +22,7 @@ import (
 	"strings"
 	"testing"
 
+	v1 "k8s.io/api/core/v1"
 	"k8s.io/apimachinery/pkg/util/sets"
 	"k8s.io/kubernetes/pkg/proxy"
 	proxyutil "k8s.io/kubernetes/pkg/proxy/util"
@@ -430,3 +431,13 @@ func TestParseServiceAnchors(t *testing.T) {
 		t.Errorf("missing anchors = %v", sets.List(missing))
 	}
 }
+
+func TestFamilyAnchors(t *testing.T) {
+	all := sets.New[string]("cni-rdr/kube-svc-v4-AAAA", "cni-rdr/kube-svc-v6-BBBB")
+	for family, want := range map[v1.IPFamily]string{v1.IPv4Protocol: "cni-rdr/kube-svc-v4-AAAA", v1.IPv6Protocol: "cni-rdr/kube-svc-v6-BBBB"} {
+		p := &Proxier{ipFamily: family}
+		if got := p.familyAnchors(all); !got.Equal(sets.New[string](want)) {
+			t.Errorf("%s: familyAnchors() = %v, want %v", family, sets.List(got), want)
+		}
+	}
+}
