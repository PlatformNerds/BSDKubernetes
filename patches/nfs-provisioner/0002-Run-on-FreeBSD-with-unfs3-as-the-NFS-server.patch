+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package volume
+
+import (
+	"io/ioutil"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestUnfsExportBlock(t *testing.T) {
+	c := &unfsExportBlockCreator{}
+	for _, tc := range []struct {
+		subnet     string
+		rootSquash bool
+		want       string
+	}{
+		{"*", false, "\n# Export_Id = 3;\n/export/pvc-a (rw,insecure,no_root_squash)\n"},
+		{"10.0.0.0/8", true, "\n# Export_Id = 3;\n/export/pvc-a 10.0.0.0/8(rw,insecure,root_squash)\n"},
+	} {
+		if got := c.CreateExportBlock("3", "/export/pvc-a", tc.rootSquash, tc.subnet); got != tc.want {
+			t.Errorf("subnet %q rootSquash %v: got %q, want %q", tc.subnet, tc.rootSquash, got, tc.want)
+		}
+	}
+}
+
+// The export IDs in use are recovered from the exports file after a restart,
+// and removing a block leaves the others.
+func TestUnfsExporterIDs(t *testing.T) {
+	dir, err := ioutil.TempDir("", "unfs")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	config := filepath.Join(dir, "exports")
+	if err := ioutil.WriteFile(config, []byte("# unfsd exports\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	e := newServerExporter(config).(*unfsExporter)
+	b1, id1, err := e.AddExportBlock("/export/a", false, "*")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := e.AddExportBlock("/export/b", false, "*"); err != nil {
+		t.Fatal(err)
+	}
+	if err := e.RemoveExportBlock(b1, id1); err != nil {
+		t.Fatal(err)
+	}
+	again := newServerExporter(config).(*unfsExporter)
+	if len(again.exportIDs) != 1 || again.exportIDs[id1] {
+		t.Errorf("recovered IDs %v, want only the second export's", again.exportIDs)
+	}
+}
