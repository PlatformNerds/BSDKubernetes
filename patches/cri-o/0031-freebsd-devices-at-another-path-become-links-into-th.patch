 server/container_create.go                   |  4 ++
 server/container_create_freebsd.go           |  1 +
 server/device_links_freebsd.go               | 40 +++++++++++++
 server/device_links_other.go                 | 11 ++++
 8 files changed, 161 insertions(+), 17 deletions(-)
 create mode 100644 server/device_links_freebsd.go
 create mode 100644 server/device_links_other.go

