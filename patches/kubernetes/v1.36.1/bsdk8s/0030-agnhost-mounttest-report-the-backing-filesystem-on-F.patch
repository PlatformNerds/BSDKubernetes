From dbbe0e5db7d2fb8d79788ebfbdb0a002b217cb82 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Wed, 18 Nov 2026 09:04:09 -0700
Subject: [PATCH 30/31] agnhost/mounttest: report the backing filesystem on
 FreeBSD

Volumes are nullfs-mounted into the jail, so f_fstypename names that
layer ("nullfs") where Linux's statfs on a bind mount reports the
filesystem behind it. nullfs passes the lower filesystem's f_type
through; FreeBSD numbers filesystem types at boot, so look the name up
in vfs.conflist ("tmpfs" for an emptyDir with medium Memory) and fall
back to f_fstypename.
---
 .../agnhost/mounttest/mt_utils_freebsd.go     | 46 +++++++++++++++++--
 1 file changed, 43 insertions(+), 3 deletions(-)

diff --git a/test/images/agnhost/mounttest/mt_utils_freebsd.go b/test/images/agnhost/mounttest/mt_utils_freebsd.go
index 033f65af0b1..826dfdab2b8 100644
--- a/test/images/agnhost/mounttest/mt_utils_freebsd.go
+++ b/test/images/agnhost/mounttest/mt_utils_freebsd.go
@@ -21,12 +21,32 @@ package mounttest
 import (
 	"strconv"
 	"syscall"
+	"unsafe"
+
+	"golang.org/x/sys/unix"
 )
 
-// statfsTypeName returns the filesystem type name of buf. FreeBSD assigns
-// filesystem type numbers (f_type) dynamically at boot, so report
-// f_fstypename instead, e.g. "tmpfs" for an emptyDir with medium Memory.
+// xvfsconf mirrors struct xvfsconf (sys/mount.h), the elements of the
+// vfs.conflist sysctl.
+type xvfsconf struct {
+	vfsops   uintptr
+	name     [16]byte // MFSNAMELEN
+	typenum  int32
+	refcount int32
+	flags    int32
+	next     uintptr
+}
+
+// statfsTypeName returns the name of the filesystem holding buf's path, like
+// Linux, whose statfs reports the type of the filesystem behind a bind
+// mount. A volume is nullfs-mounted into the jail, and f_fstypename names
+// that layer ("nullfs"), but f_type is the number of the filesystem below it
+// (tmpfs for an emptyDir with medium Memory). FreeBSD assigns those numbers
+// at boot: look the name up in vfs.conflist.
 func statfsTypeName(buf *syscall.Statfs_t) string {
+	if name := vfsName(int32(buf.Type)); name != "" {
+		return name
+	}
 	n := make([]byte, 0, len(buf.Fstypename))
 	for _, c := range buf.Fstypename {
 		if c == 0 {
@@ -40,6 +60,26 @@ func statfsTypeName(buf *syscall.Statfs_t) string {
 	return string(n)
 }
 
+// vfsName returns the name of filesystem type number typenum, or "".
+func vfsName(typenum int32) string {
+	conf, err := unix.SysctlRaw("vfs.conflist")
+	if err != nil {
+		return ""
+	}
+	size := int(unsafe.Sizeof(xvfsconf{}))
+	for off := 0; off+size <= len(conf); off += size {
+		vfc := (*xvfsconf)(unsafe.Pointer(&conf[off]))
+		if vfc.typenum == typenum {
+			n := 0
+			for n < len(vfc.name) && vfc.name[n] != 0 {
+				n++
+			}
+			return string(vfc.name[:n])
+		}
+	}
+	return ""
+}
+
 // formatFsType returns a string representation of the filesystem type number.
 func formatFsType(fsType int64) string {
 	return strconv.FormatInt(fsType, 10)
-- 
