From be5ab30bb71fdb97a6e1223f6b7bb6f78e095cd7 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Sun, 22 Nov 2026 18:46:25 -0700
Subject: [PATCH 52/52] e2e: FreeBSD loopback local volume online expansion

ExpandBlockDevice ran the Linux "dd oflag=append" and "losetup -c". The
file system is mounted on loopDir, so loopDir/file names a file inside
it, not the backing file (upstream's dd appends to that inner file). On
FreeBSD grow the md(4) device itself with mdconfig -r by mbToAdd from
its diskinfo media size; a vnode md may be larger than its backing file.

The test's AfterEach unmounted the loop file system while the test pod
still ran; on FreeBSD the container's nullfs mount keeps it busy, so
delete the pod first.
---
 test/e2e/storage/local_volume_resize.go | 14 ++++++++++----
 test/e2e/storage/utils/local.go         |  9 +++++++++
 2 files changed, 19 insertions(+), 4 deletions(-)

diff --git a/test/e2e/storage/local_volume_resize.go b/test/e2e/storage/local_volume_resize.go
index c389bcbb756..2b9dbeb0277 100644
--- a/test/e2e/storage/local_volume_resize.go
+++ b/test/e2e/storage/local_volume_resize.go
@@ -34,6 +34,7 @@ import (
 	"k8s.io/apimachinery/pkg/util/wait"
 	"k8s.io/kubernetes/test/e2e/framework"
 	e2enode "k8s.io/kubernetes/test/e2e/framework/node"
+	e2epod "k8s.io/kubernetes/test/e2e/framework/pod"
 	"k8s.io/kubernetes/test/e2e/storage/testsuites"
 	"k8s.io/kubernetes/test/e2e/storage/utils"
 	admissionapi "k8s.io/pod-security-admission/api"
@@ -54,6 +55,7 @@ var _ = utils.SIGDescribe("PersistentVolumes-expansion", func() {
 
 		testVolType := BlockFsWithFormatLocalVolumeType
 		var testVol *localTestVolume
+		var pod1 *v1.Pod
 		testMode := immediateMode
 		ginkgo.BeforeEach(func(ctx context.Context) {
 			nodes, err := e2enode.GetBoundedReadySchedulableNodes(ctx, f.ClientSet, maxNodes)
@@ -82,15 +84,19 @@ var _ = utils.SIGDescribe("PersistentVolumes-expansion", func() {
 			testVol = testVols[0]
 		})
 		ginkgo.AfterEach(func(ctx context.Context) {
+			// Delete the pod before unmounting the volume under it: on
+			// FreeBSD the container's nullfs mount keeps the loop file
+			// system busy until the pod is gone.
+			if pod1 != nil {
+				framework.ExpectNoError(e2epod.DeletePodWithWait(ctx, config.client, pod1))
+				pod1 = nil
+			}
 			cleanupLocalVolumes(ctx, config, []*localTestVolume{testVol})
 			cleanupStorageClass(ctx, config)
 		})
 
 		ginkgo.It("should support online expansion on node", func(ctx context.Context) {
-			var (
-				pod1    *v1.Pod
-				pod1Err error
-			)
+			var pod1Err error
 			ginkgo.By("Creating pod1")
 			pod1, pod1Err = createLocalPod(ctx, config, testVol, nil)
 			framework.ExpectNoError(pod1Err)
diff --git a/test/e2e/storage/utils/local.go b/test/e2e/storage/utils/local.go
index a42812704a4..9a323394f69 100644
--- a/test/e2e/storage/utils/local.go
+++ b/test/e2e/storage/utils/local.go
@@ -312,6 +312,15 @@ func (l *ltrMgr) expandLocalVolumeBlockFS(ctx context.Context, ltr *LocalTestRes
 	ddCmd := fmt.Sprintf("dd if=/dev/zero of=%s/file conv=notrunc oflag=append bs=1M count=%d", ltr.loopDir, mbToAdd)
 	loopDev := l.findLoopDevice(ctx, ltr.loopDir, ltr.Node)
 	losetupCmd := fmt.Sprintf("losetup -c %s", loopDev)
+	if isFreeBSD(ltr.Node) {
+		// The file system is mounted on loopDir, so loopDir/file names a
+		// file inside it, not the backing file (the Linux dd above appends
+		// to that inner file). Grow the md(4) device itself by mbToAdd:
+		// a vnode md may be larger than its backing file, which grows as
+		// the new blocks are written.
+		md := strings.TrimPrefix(loopDev, "/dev/")
+		return l.hostExec.IssueCommand(ctx, fmt.Sprintf("mdconfig -r -u %s -s $(( $(diskinfo %s | awk '{ print $3 }') / 1024 + %d * 1024 ))k", md, loopDev, mbToAdd), ltr.Node)
+	}
 	return l.hostExec.IssueCommand(ctx, fmt.Sprintf("%s && %s", ddCmd, losetupCmd), ltr.Node)
 }
 
