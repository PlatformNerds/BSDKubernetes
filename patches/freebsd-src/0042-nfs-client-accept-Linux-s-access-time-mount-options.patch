From 2b95a72a39cebc776e182b6129070184b82eec30 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Fri, 20 Nov 2026 18:08:02 -0700
Subject: [PATCH] nfs client: accept Linux's access time mount options

Mount options written for Linux, e.g. the mountOptions of a Kubernetes
PersistentVolume or StorageClass, often carry relatime, Linux's default
access time mode, and an NFS mount with it failed: "mount option
<relatime> is unknown". Accept Linux's access time modes, relatime,
strictatime, lazytime and [no]diratime. The server keeps an NFS file's
access time, so they ask nothing of the client, as on Linux; they stay
in the mount's options, where linprocfs shows relatime in Linux's mount
table.
---
 sys/fs/nfsclient/nfs_clvfsops.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/sys/fs/nfsclient/nfs_clvfsops.c b/sys/fs/nfsclient/nfs_clvfsops.c
index 74e5e2dc9..b85bd6cc4 100644
--- a/sys/fs/nfsclient/nfs_clvfsops.c
+++ b/sys/fs/nfsclient/nfs_clvfsops.c
@@ -778,7 +778,15 @@ nfs_decode_args(struct mount *mp, struct nfsmount *nmp, struct nfs_args *argp,
 	}
 }
 
+/*
+ * "relatime", "strictatime", "lazytime" and "[no]diratime" are Linux's
+ * access time modes, accepted (and kept in the mount's options) for mount
+ * options written for Linux, e.g. in Kubernetes PersistentVolumes. The
+ * server keeps an NFS file's access time, so they ask nothing of the
+ * client, as on Linux.
+ */
 static const char *nfs_opts[] = { "from", "nfs_args",
+    "relatime", "strictatime", "lazytime", "diratime",
     "noac", "noatime", "noexec", "suiddir", "nosuid", "nosymfollow", "union",
     "noclusterr", "noclusterw", "multilabel", "acls", "force", "update",
     "async", "noconn", "nolockd", "conn", "lockd", "intr", "rdirplus",
