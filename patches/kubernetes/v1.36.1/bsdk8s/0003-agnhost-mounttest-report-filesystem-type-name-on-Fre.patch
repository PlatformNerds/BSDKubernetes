From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Sat, 14 Nov 2026 00:13:33 -0700
Subject: [PATCH] agnhost/mounttest: report filesystem type name on FreeBSD

FreeBSD assigns filesystem type numbers (statfs f_type) dynamically, so
'mount type of /test-volume: 135' can't be matched against 'tmpfs' by the
EmptyDir conformance tests. Report f_fstypename instead. Linux and other
platforms are unchanged.
---
 test/images/agnhost/mounttest/mt_utils.go     |  2 +-
 .../agnhost/mounttest/mt_utils_freebsd.go     | 46 +++++++++++++++++++
 .../agnhost/mounttest/mt_utils_linux.go       |  6 +++
 .../agnhost/mounttest/mt_utils_other.go       | 12 ++++-
 4 files changed, 63 insertions(+), 3 deletions(-)
 create mode 100644 test/images/agnhost/mounttest/mt_utils_freebsd.go

diff --git a/test/images/agnhost/mounttest/mt_utils.go b/test/images/agnhost/mounttest/mt_utils.go
index b2ccbd925c8..2415a9a28ef 100644
--- a/test/images/agnhost/mounttest/mt_utils.go
+++ b/test/images/agnhost/mounttest/mt_utils.go
@@ -39,7 +39,7 @@ func fsType(path string) error {
 		return err
 	}
 
-	fmt.Printf("mount type of %q: %s\n", path, formatFsType(int64(buf.Type)))
+	fmt.Printf("mount type of %q: %s\n", path, statfsTypeName(&buf))
 
 	return nil
 }
diff --git a/test/images/agnhost/mounttest/mt_utils_freebsd.go b/test/images/agnhost/mounttest/mt_utils_freebsd.go
new file mode 100644
index 00000000000..033f65af0b1
--- /dev/null
+++ b/test/images/agnhost/mounttest/mt_utils_freebsd.go
@@ -0,0 +1,46 @@
