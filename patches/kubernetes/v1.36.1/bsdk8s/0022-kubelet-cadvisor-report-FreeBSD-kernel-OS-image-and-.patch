From c45bdbf5b493acf6fab19d0236a2c0741f2baff2 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Tue, 17 Nov 2026 20:51:27 -0700
Subject: [PATCH] kubelet/cadvisor: report FreeBSD kernel, OS image and node
 identity

On FreeBSD the node's kernelVersion, osImage, bootID and systemUUID were
empty (kubectl get nodes -o wide showed <unknown>) and machineID was the
host name. Report what cadvisor reports on Linux:

- kernelVersion: kern.osrelease (uname -r)
- osImage: PRETTY_NAME from /etc/os-release
- bootID: kern.boot_id (16 random bytes per boot) formatted as a UUID, so
  the kubelet's Rebooted event works
- systemUUID: kern.hostuuid (SMBIOS UUID, or the one FreeBSD generated)
- machineID: /etc/machine-id, falling back to the host name
---
 pkg/kubelet/cadvisor/cadvisor_freebsd.go      | 60 ++++++++++++++++++-
 pkg/kubelet/cadvisor/cadvisor_freebsd_test.go | 44 ++++++++++++++
 2 files changed, 102 insertions(+), 2 deletions(-)

diff --git a/pkg/kubelet/cadvisor/cadvisor_freebsd.go b/pkg/kubelet/cadvisor/cadvisor_freebsd.go
index b1c7a5da5be..236f89ac721 100644
--- a/pkg/kubelet/cadvisor/cadvisor_freebsd.go
+++ b/pkg/kubelet/cadvisor/cadvisor_freebsd.go
@@ -82,8 +82,59 @@ func (cc *cadvisorClient) ContainerInfoV2(name string, options cadvisorapiv2.Req
 	return infos, nil
 }
 
+// VersionInfo reports what cadvisor reports on Linux: the kernel release
+// (uname -r) and the PRETTY_NAME of os-release(5).
 func (cc *cadvisorClient) VersionInfo() (*cadvisorapi.VersionInfo, error) {
-	return &cadvisorapi.VersionInfo{}, nil
+	release, err := unix.Sysctl("kern.osrelease")
+	if err != nil {
+		return nil, err
+	}
+	return &cadvisorapi.VersionInfo{
+		KernelVersion:      release,
+		ContainerOsVersion: osPrettyName("/etc/os-release", "FreeBSD "+release),
+	}, nil
+}
+
+// osPrettyName returns PRETTY_NAME from an os-release(5) file, or def.
+func osPrettyName(path, def string) string {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return def
+	}
+	for _, line := range strings.Split(string(data), "\n") {
+		v, ok := strings.CutPrefix(strings.TrimSpace(line), "PRETTY_NAME=")
+		if !ok {
+			continue
+		}
+		if u, err := strconv.Unquote(v); err == nil {
+			v = u
+		}
+		if v != "" {
+			return v
+		}
+	}
+	return def
+}
+
+// bootID formats kern.boot_id, 16 random bytes chosen once per boot, as a
+// UUID like Linux's /proc/sys/kernel/random/boot_id.  The kubelet records a
+// Rebooted event when it changes.
+func bootID() string {
+	b, err := unix.SysctlRaw("kern.boot_id")
+	if err != nil || len(b) != 16 {
+		return ""
+	}
+	return fmt.Sprintf("%x-%x-%x-%x-%x", b[0:4], b[4:6], b[6:8], b[8:10], b[10:16])
+}
+
+// machineID returns the contents of /etc/machine-id, which FreeBSD writes
+// from the host UUID, or the host name if there is none.
+func machineID(hostname string) string {
+	data, err := os.ReadFile("/etc/machine-id")
+	if id := strings.TrimSpace(string(data)); err == nil && id != "" {
+		return id
+	}
+	return hostname
 }
 
 func (cc *cadvisorClient) SubcontainerInfo(name string, req *cadvisorapi.ContainerInfoRequest) (map[string]*cadvisorapi.ContainerInfo, error) {
@@ -111,12 +162,17 @@ func (cc *cadvisorClient) MachineInfo() (*cadvisorapi.MachineInfo, error) {
 		return nil, err
 	}
 
+	// The SMBIOS system UUID, or the UUID FreeBSD generated if there is none.
+	systemUUID, _ := unix.Sysctl("kern.hostuuid")
+
 	return &cadvisorapi.MachineInfo{
 		NumCores:         int(cores),
 		NumPhysicalCores: int(physCores),
 		NumSockets:       1,
 		MemoryCapacity:   uint64(memTotal),
-		MachineID:        hostname,
+		MachineID:        machineID(hostname),
+		SystemUUID:       systemUUID,
+		BootID:           bootID(),
 	}, nil
 }
 
diff --git a/pkg/kubelet/cadvisor/cadvisor_freebsd_test.go b/pkg/kubelet/cadvisor/cadvisor_freebsd_test.go
index 0dd4fdc033b..23e5b6b0780 100644
--- a/pkg/kubelet/cadvisor/cadvisor_freebsd_test.go
+++ b/pkg/kubelet/cadvisor/cadvisor_freebsd_test.go
@@ -98,3 +98,47 @@ func TestTmpfsUsedLive(t *testing.T) {
 		t.Errorf("tmpfs usage %d MB -> %d MB after writing 64 MB", before/mb, after/mb)
 	}
 }
+
+func TestOSPrettyName(t *testing.T) {
+	dir := t.TempDir()
+	for _, tc := range []struct{ name, content, want string }{
+		{"quoted", "NAME=FreeBSD\nPRETTY_NAME=\"FreeBSD 15.1-RELEASE-p6\"\n", "FreeBSD 15.1-RELEASE-p6"},
+		{"unquoted", "PRETTY_NAME=FreeBSD\n", "FreeBSD"},
+		{"empty", "PRETTY_NAME=\"\"\n", "default"},
+		{"absent", "NAME=FreeBSD\n", "default"},
+	} {
+		p := filepath.Join(dir, tc.name)
+		if err := os.WriteFile(p, []byte(tc.content), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		if got := osPrettyName(p, "default"); got != tc.want {
+			t.Errorf("%s: got %q, want %q", tc.name, got, tc.want)
+		}
+	}
+	if got := osPrettyName(filepath.Join(dir, "missing"), "default"); got != "default" {
+		t.Errorf("missing file: got %q", got)
+	}
+}
+
+func TestNodeIdentityLive(t *testing.T) {
+	cc := &cadvisorClient{}
+	v, err := cc.VersionInfo()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if v.KernelVersion == "" || v.ContainerOsVersion == "" {
+		t.Errorf("empty version info: %+v", v)
+	}
+	m, err := cc.MachineInfo()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(m.BootID) != 36 || m.BootID != bootID() {
+		t.Errorf("boot ID %q is not a stable UUID", m.BootID)
+	}
+	if m.SystemUUID == "" || m.MachineID == "" {
+		t.Errorf("empty identity: %+v", m)
+	}
+	t.Logf("kernel %q, os %q, boot %s, system %s, machine %s", v.KernelVersion,
+		v.ContainerOsVersion, m.BootID, m.SystemUUID, m.MachineID)
+}
-- 
