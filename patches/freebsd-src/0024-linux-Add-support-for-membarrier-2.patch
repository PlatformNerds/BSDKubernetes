 sys/compat/linux/linux_dummy.c    |  2 -
 sys/compat/linux/linux_misc.c     | 64 +++++++++++++++++++++++++++++++
 sys/compat/linux/linux_misc.h     | 16 ++++++++
 sys/i386/linux/syscalls.master    |  3 +-
 7 files changed, 88 insertions(+), 6 deletions(-)

