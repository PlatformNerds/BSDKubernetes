From 92f38fe72f8e6abd9c9ca83cd2543ac5d2c558c3 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Wed, 18 Nov 2026 17:29:05 -0700
Subject: [PATCH] mount-utils: implement GetMountRefs on FreeBSD

It returned "mount.GetMountRefs unsupported", so a local
PersistentVolume could not be mounted for a pod with fsGroup: the local
plugin checks for other users of the volume before changing ownership
(MountVolume.SetUp failed ... GetMountRefs unsupported).

On FreeBSD bind mounts are nullfs mounts whose source names the
directory they show: the references are the nullfs mounts that share
the path's source, from getfsstat(2).
---
 .../src/k8s.io/mount-utils/mount_freebsd.go   | 49 +++++++++++++++--
 .../k8s.io/mount-utils/mount_freebsd_test.go  | 52 +++++++++++++++++++
 2 files changed, 98 insertions(+), 3 deletions(-)
 create mode 100644 staging/src/k8s.io/mount-utils/mount_freebsd_test.go

diff --git a/staging/src/k8s.io/mount-utils/mount_freebsd.go b/staging/src/k8s.io/mount-utils/mount_freebsd.go
index 43673a6fd50..5dc62357019 100644
--- a/staging/src/k8s.io/mount-utils/mount_freebsd.go
+++ b/staging/src/k8s.io/mount-utils/mount_freebsd.go
@@ -22,6 +22,7 @@ import (
 	"errors"
 	"fmt"
 	"os/exec"
+	"path/filepath"
 	"strings"
 
 	"github.com/moby/sys/mountinfo"
@@ -133,10 +134,52 @@ func (mounter *Mounter) IsMountPoint(file string) (bool, error) {
 	return false, nil
 }
 
-// GetMountRefs always returns an error on unsupported platforms
+// GetMountRefs finds the other mount points of the directory pathname is, or
+// is mounted from. FreeBSD's bind mounts are nullfs mounts, whose source
+// (f_mntfromname) is the directory they show, so the references are the nullfs
+// mounts that share pathname's source. Like Linux, pathname itself is left out.
+// The local volume plugin uses this to see whether another pod already uses a
+// volume before it applies fsGroup.
 func (mounter *Mounter) GetMountRefs(pathname string) ([]string, error) {
-	//return nil, errUnsupported
-	return nil, errors.New("mount.GetMountRefs unsupported")
+	pathExists, pathErr := PathExists(pathname)
+	if !pathExists {
+		return []string{}, nil
+	} else if IsCorruptedMnt(pathErr) {
+		klog.Warningf("GetMountRefs found corrupted mount at %s, treating as unmounted path", pathname)
+		return []string{}, nil
+	} else if pathErr != nil {
+		return nil, fmt.Errorf("error checking path %s: %v", pathname, pathErr)
+	}
+	realpath, err := filepath.EvalSymlinks(pathname)
+	if err != nil {
+		return nil, err
+	}
+	mps, err := mounter.List()
+	if err != nil {
+		return nil, err
+	}
+	return nullfsMountRefs(realpath, mps), nil
+}
+
+// nullfsMountRefs returns the nullfs mount points showing the same directory
+// as path, other than path: path's own source if path is a nullfs mount point,
+// otherwise path itself.
+func nullfsMountRefs(path string, mps []MountPoint) []string {
+	path = filepath.Clean(path)
+	source := path
+	for _, mp := range mps {
+		if mp.Type == "nullfs" && filepath.Clean(mp.Path) == path {
+			source = filepath.Clean(mp.Device)
+		}
+	}
+	refs := []string{}
+	for _, mp := range mps {
+		p := filepath.Clean(mp.Path)
+		if mp.Type == "nullfs" && filepath.Clean(mp.Device) == source && p != path {
+			refs = append(refs, p)
+		}
+	}
+	return refs
 }
 
 func (mounter *SafeFormatAndMount) formatAndMountSensitive(source string, target string, fstype string, options []string, sensitiveOptions []string, formatOptions []string) error {
diff --git a/staging/src/k8s.io/mount-utils/mount_freebsd_test.go b/staging/src/k8s.io/mount-utils/mount_freebsd_test.go
