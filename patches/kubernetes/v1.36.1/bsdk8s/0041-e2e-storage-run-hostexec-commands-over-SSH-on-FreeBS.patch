From 6c78d2209ebe6ff64834f0c5cdc87bff9eae00a6 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Fri, 20 Nov 2026 20:51:00 -0700
Subject: [PATCH] e2e/storage: run hostexec commands over SSH on FreeBSD nodes

The hostexec pod reaches the node by entering PID 1's mount namespace
with nsenter. FreeBSD has no namespaces: a container is a jail, and a
jailed process can't leave it, so every test that prepares the node
through hostexec (local PersistentVolumes, among others) failed at setup.

On a node labelled kubernetes.io/os=freebsd, run the command as root over
the framework's SSH helper instead (the provider's key, KUBE_SSH_USER,
sudo -n when that user isn't root). The commands then act on the node's
own file systems, as nsenter does on Linux.

Bind-mounted local volumes use "mount -t nullfs", FreeBSD's bind mount.
---
 test/e2e/storage/utils/host_exec.go | 53 +++++++++++++++++++++++++++++
 test/e2e/storage/utils/local.go     | 13 +++++--
 2 files changed, 64 insertions(+), 2 deletions(-)

diff --git a/test/e2e/storage/utils/host_exec.go b/test/e2e/storage/utils/host_exec.go
index 202377323e7..72f1eedc116 100644
--- a/test/e2e/storage/utils/host_exec.go
+++ b/test/e2e/storage/utils/host_exec.go
@@ -19,12 +19,16 @@ package utils
 import (
 	"context"
 	"fmt"
+	"net"
+	"os"
+	"strings"
 
 	v1 "k8s.io/api/core/v1"
 	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
 	"k8s.io/client-go/util/exec"
 	"k8s.io/kubernetes/test/e2e/framework"
 	e2epod "k8s.io/kubernetes/test/e2e/framework/pod"
+	e2essh "k8s.io/kubernetes/test/e2e/framework/ssh"
 )
 
 // Result holds the execution result of remote execution command.
@@ -138,6 +142,9 @@ func (h *hostExecutor) exec(ctx context.Context, cmd string, node *v1.Node) (Res
 		Host: node.Name,
 		Cmd:  cmd,
 	}
+	if node.Labels[v1.LabelOSStable] == "freebsd" {
+		return h.sshExec(ctx, cmd, node)
+	}
 	pod, ok := h.nodeExecPods[node.Name]
 	if !ok {
 		pod = h.launchNodeExecPod(ctx, node.Name)
@@ -169,6 +176,52 @@ func (h *hostExecutor) exec(ctx context.Context, cmd string, node *v1.Node) (Res
 	return result, err
 }
 
+// sshExec runs cmd as root on a FreeBSD node over SSH.
+//
+// The hostexec pod reaches the host by entering PID 1's mount namespace with
+// nsenter. FreeBSD has no namespaces: a container is a jail, and a jailed
+// process can't leave its jail. SSH gives the same thing, a root shell on the
+// node, so the commands see the node's own file systems and their mounts are
+// the node's. It needs the provider's SSH key (LOCAL_SSH_KEY for "local") and
+// KUBE_SSH_USER; a user other than root runs the command through sudo.
+func (h *hostExecutor) sshExec(ctx context.Context, cmd string, node *v1.Node) (Result, error) {
+	result := Result{Host: node.Name, Cmd: cmd}
+	addr := ""
+	for _, a := range node.Status.Addresses {
+		if a.Type == v1.NodeInternalIP && a.Address != "" {
+			addr = a.Address
+			break
+		}
+	}
+	if addr == "" {
+		return result, fmt.Errorf("node %q has no internal IP to SSH to", node.Name)
+	}
+	user := os.Getenv("KUBE_SSH_USER")
+	if user == "" {
+		user = os.Getenv("USER")
+	}
+	remote := "sh -c " + shellQuote(cmd)
+	if user != "root" {
+		remote = "sudo -n " + remote
+	}
+	r, err := e2essh.SSH(ctx, remote, net.JoinHostPort(addr, e2essh.SSHPort), framework.TestContext.Provider)
+	result.Stdout, result.Stderr, result.Code = r.Stdout, r.Stderr, r.Code
+	if err != nil {
+		return result, fmt.Errorf("ssh to node %q: %w", node.Name, err)
+	}
+	if r.Code != 0 {
+		return result, exec.CodeExitError{
+			Err:  fmt.Errorf("command %q on node %q exited with %d: %s", cmd, node.Name, r.Code, r.Stderr),
+			Code: r.Code,
+		}
+	}
+	return result, nil
+}
+
+func shellQuote(s string) string {
+	return "'" + strings.ReplaceAll(s, "'", `'\''`) + "'"
+}
+
 // IssueCommandWithResult issues command on the given node and returns stdout as
 // result. It returns error if there are some issues executing the command or
 // the command exits non-zero.
diff --git a/test/e2e/storage/utils/local.go b/test/e2e/storage/utils/local.go
index 1dccee34625..00e7e7f0b61 100644
--- a/test/e2e/storage/utils/local.go
+++ b/test/e2e/storage/utils/local.go
@@ -236,7 +236,7 @@ func (l *ltrMgr) cleanupLocalVolumeDirectoryLink(ctx context.Context, ltr *Local
 
 func (l *ltrMgr) setupLocalVolumeDirectoryBindMounted(ctx context.Context, node *v1.Node, parameters map[string]string) *LocalTestResource {
 	hostDir := l.getTestDir()
-	cmd := fmt.Sprintf("mkdir -p %s && mount --bind %s %s", hostDir, hostDir, hostDir)
+	cmd := fmt.Sprintf("mkdir -p %s && %s %s %s", hostDir, bindMount(node), hostDir, hostDir)
 	err := l.hostExec.IssueCommand(ctx, cmd, node)
 	framework.ExpectNoError(err)
 	return &LocalTestResource{
@@ -256,7 +256,7 @@ func (l *ltrMgr) cleanupLocalVolumeDirectoryBindMounted(ctx context.Context, ltr
 func (l *ltrMgr) setupLocalVolumeDirectoryLinkBindMounted(ctx context.Context, node *v1.Node, parameters map[string]string) *LocalTestResource {
 	hostDir := l.getTestDir()
 	hostDirBackend := hostDir + "-backend"
-	cmd := fmt.Sprintf("mkdir -p %s && mount --bind %s %s && ln -s %s %s", hostDirBackend, hostDirBackend, hostDirBackend, hostDirBackend, hostDir)
+	cmd := fmt.Sprintf("mkdir -p %s && %s %s %s && ln -s %s %s", hostDirBackend, bindMount(node), hostDirBackend, hostDirBackend, hostDirBackend, hostDir)
 	err := l.hostExec.IssueCommand(ctx, cmd, node)
 	framework.ExpectNoError(err)
 	return &LocalTestResource{
@@ -360,3 +360,12 @@ func (l *ltrMgr) Remove(ctx context.Context, ltr *LocalTestResource) {
 	}
 	return
 }
+
+// bindMount returns the command that bind-mounts a directory on node: FreeBSD's
+// bind mount is nullfs.
+func bindMount(node *v1.Node) string {
+	if node.Labels[v1.LabelOSStable] == "freebsd" {
+		return "mount -t nullfs"
+	}
+	return "mount --bind"
+}
-- 
