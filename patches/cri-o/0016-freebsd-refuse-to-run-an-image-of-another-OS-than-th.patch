From a28e80e5e03995dddd887e18a911eb79bc3c9187 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Mon, 16 Nov 2026 22:16:03 -0700
Subject: [PATCH 16/17] freebsd: refuse to run an image of another OS than the
 handler's

The kubelet asks whether an image is present by name only. When the
local copy of a tag is a FreeBSD image (e.g. a FreeBSD build published
under an upstream name), a pod of the Linux handler
(io.bsdk8s.image-os=linux) was created from it and silently ran FreeBSD
binaries in a pod that asked for Linux.

Check the resolved image's OS against the handler's declared image OS
when creating the container, and fail with an error that names both,
so the mismatch is visible instead of half-working.
---
 server/container_create.go |  4 ++++
 server/image_os_freebsd.go | 26 ++++++++++++++++++++++++++
 server/image_os_other.go   |  3 +++
 3 files changed, 33 insertions(+)

diff --git a/server/container_create.go b/server/container_create.go
index 872e086fd..953d7c03c 100644
--- a/server/container_create.go
+++ b/server/container_create.go
@@ -1324,6 +1324,10 @@ func (s *Server) resolveAndVerifyContainerImage(ctx context.Context, ctr contain
 		return nil, err
 	}
 
+	if err := s.checkImageOS(sb.RuntimeHandler(), userRequestedImage, imgResult); err != nil {
+		return nil, err
+	}
+
 	return &containerImageResult{
 		userRequestedImage: userRequestedImage,
 		imgResult:          imgResult,
diff --git a/server/image_os_freebsd.go b/server/image_os_freebsd.go
index 2a078c56a..cce466eb9 100644
--- a/server/image_os_freebsd.go
+++ b/server/image_os_freebsd.go
@@ -1,6 +1,7 @@
 package server
 
 import (
+	"fmt"
 	"path/filepath"
 
 	"golang.org/x/sys/unix"
@@ -103,3 +104,28 @@ var linuxImageMounts = []rspec.Mount{
 // imageOSFallbacks: images of the Linux RuntimeClass are stored as Linux
 // instances; see imageStatusByName.
 func imageOSFallbacks() []string { return []string{"linux"} }
+
+// checkImageOS refuses to create a container of a handler that declares an
+// image OS (ImageOSAnnotation) from an image of another OS. The kubelet asks
+// whether an image is present by name only, so when the local copy of a tag
+// is a FreeBSD image, a pod of the Linux handler would otherwise silently run
+// FreeBSD binaries (and the reverse).
+func (s *Server) checkImageOS(handler, userRequestedImage string, img *storage.ImageResult) error {
+	h, ok := s.config.Runtimes[handler]
+	if !ok || h == nil {
+		return nil
+	}
+
+	want := h.DefaultAnnotations[ImageOSAnnotation]
+	if want == "" || img == nil || img.OCIConfig == nil || img.OCIConfig.OS == "" {
+		return nil
+	}
+
+	if img.OCIConfig.OS != want {
+		return fmt.Errorf("image %q (%s) is a %s image, but runtime handler %q runs %s images; "+
+			"the local copy of this tag is for another OS, remove it or use a %s image",
+			userRequestedImage, img.ID, img.OCIConfig.OS, handler, want, want)
+	}
+
+	return nil
+}
diff --git a/server/image_os_other.go b/server/image_os_other.go
index 61d164224..590bfaec7 100644
--- a/server/image_os_other.go
+++ b/server/image_os_other.go
@@ -17,3 +17,6 @@ func addImageOSMounts(_ *generate.Generator, _ *storage.ImageResult, _ *types.Co
 
 // imageOSFallbacks: images are always resolved for the host's OS.
 func imageOSFallbacks() []string { return nil }
+
+// checkImageOS: there is no per-handler image OS on this platform.
+func (s *Server) checkImageOS(_, _ string, _ *storage.ImageResult) error { return nil }
