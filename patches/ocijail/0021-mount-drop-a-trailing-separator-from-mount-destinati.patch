From afbeda9c5464c84344b992bba059709d7b97d44f Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Tue, 24 Nov 2026 11:15:50 -0700
Subject: [PATCH] mount: drop a trailing separator from mount destinations

A destination with a trailing slash ("/data/", which Kubernetes allows for
a volume mountPath; the StatefulSet e2e tests use it) resolved to a path
with a trailing separator, and that path was recorded for the unmount.
When the runtime has already (force-)unmounted the container's root, as
CRI-O does when a container stops, the mount has no path that resolves and
unmount(2) falls back to comparing the string with the stored mount point,
which has no trailing separator: EINVAL, the mount leaked and the kubelet
could never unmount the volume, so the pod stayed Terminating (and an
OrderedReady StatefulSet could not scale down).

Skip empty and "." elements when resolving, and strip a trailing separator
from paths recorded by earlier versions. test_mount_trailing_slash_unmounted
reproduces it (fails before, passes after); run_test 34/34, create_test
12/12.
---
 ocijail/mount.cpp | 15 +++++++++++++++
 test/run_test.py  | 39 +++++++++++++++++++++++++++++++++++++++
 2 files changed, 54 insertions(+)

diff --git a/ocijail/mount.cpp b/ocijail/mount.cpp
index bc97b99..9d736d9 100644
--- a/ocijail/mount.cpp
+++ b/ocijail/mount.cpp
@@ -204,6 +204,16 @@ static fs::path resolve_container_path_impl(main_app& app,
     for (const auto& element : path) {
         app.log_debug() << "resolved_path: " << resolved_path
                         << ", element: " << element;
+        // A trailing separator ("/data/", which Kubernetes allows for a
+        // volume's mountPath) iterates as a final empty element. Appending it
+        // would leave a trailing separator on the result, and that path is
+        // recorded for the unmount: unmount(2) matches it against the mount
+        // point the kernel stores, which has none, so it fails with EINVAL,
+        // the mount leaks and the kubelet can never unmount the volume (the
+        // pod stays Terminating). The same goes for "." elements.
+        if (element.empty() || element == ".") {
+            continue;
+        }
         if (element.is_absolute()) {
             resolved_path = root_path;
         } else {
@@ -665,6 +675,11 @@ static void unmount_volume(main_app& app,
     auto destination = recorded.is_string()
                            ? fs::path{recorded.get<std::string>()}
                            : resolve_container_path(app, root_path, mount);
+    // Paths recorded by versions that kept a mountPath's trailing separator
+    // (see resolve_container_path_impl) would not match the mount point.
+    while (!destination.has_filename() && destination.has_relative_path()) {
+        destination = destination.parent_path();
+    }
 
     // Whether the source is a file only matters without file mount support.
     // Don't stat it otherwise: for an NFS volume whose server is gone, stat(2)
diff --git a/test/run_test.py b/test/run_test.py
index d68cdd4..63ba76b 100644
--- a/test/run_test.py
+++ b/test/run_test.py
@@ -716,6 +716,45 @@ class test_run(unittest.TestCase):
             # before we delete root_dir
             self.delete()
 
+    def test_mount_trailing_slash_unmounted(self):
+        # A destination with a trailing slash ("/data/", as a Kubernetes
+        # volume mountPath may have) must still be unmounted on delete, also
+        # after the runtime has (force-)unmounted the container's root file
+        # system, as CRI-O does when a container stops. The mount then has no
+        # path that resolves, and unmount(2) falls back to comparing the path
+        # string with the mount point the kernel stores: "/data/" did not
+        # match, the mount leaked and kept the volume busy for good.
+        with tempfile.TemporaryDirectory() as root_dir, \
+                tempfile.TemporaryDirectory() as src_dir:
+            root_dir = os.path.realpath(root_dir)
+            subprocess.run(["mount", "-t", "tmpfs", "tmpfs", root_dir],
+                           check=True)
+            try:
+                shutil.copytree("/rescue", os.path.join(root_dir, "rescue"))
+                c = self.config()
+                c["root"]["path"] = root_dir
+                c["process"]["args"] = ["sh", "-c", "echo x > /data/x"]
+                c["process"]["env"] = ["PATH=/rescue"]
+                c["mounts"] = [
+                    {
+                        "type": "nullfs",
+                        "destination": "/data/",
+                        "source": src_dir,
+                    },
+                ]
+                ret, out, _ = self.run_with_config(c)
+                self.assertEqual(ret, 0)
+                self.assertTrue(os.path.exists(os.path.join(src_dir, "x")))
+                subprocess.run(["umount", "-f", root_dir], check=True)
+                self.delete()
+                mounts = subprocess.run(["mount", "-p"], capture_output=True,
+                                        text=True, check=True).stdout
+                self.assertNotIn(os.path.join(root_dir, "data"), mounts)
+            finally:
+                for path in (os.path.join(root_dir, "data"), root_dir):
+                    subprocess.run(["umount", "-f", path],
+                                   capture_output=True)
+
     def test_readonly_root(self):
         # Running the container should not modify the root
         with tempfile.TemporaryDirectory() as root_dir:
