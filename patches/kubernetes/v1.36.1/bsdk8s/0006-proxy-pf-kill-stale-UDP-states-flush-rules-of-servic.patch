From b2cb87563f303d0f6ef3ce80353ae6ce8ac82b4b Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Sat, 14 Nov 2026 15:18:51 -0700
Subject: [PATCH 6/6] proxy/pf: kill stale UDP states; flush rules of services
 without endpoints

UDP has no teardown, so a pf rdr state kept a client (fixed source address
and port) pinned to the endpoint it first picked after that endpoint was
deleted or the target port changed; a client that keeps sending never lets
the state expire. After each sync, list pf states and kill (by key) the
inbound UDP rdr states of known UDP Service frontends whose endpoint is no
longer current: the pf equivalent of the iptables proxier's conntrack
cleanup. Fixes the Conntrack e2e tests 'should be able to preserve UDP
traffic when server pod cycles for a NodePort service' and '...cleanup
conntrack entries when UDP service target port changes for a NodePort
service'.

Also, a service whose endpoints all went away kept its old rdr rules
(the sync skipped it without rewriting its anchor); flush them.
---
 pkg/proxy/pf/proxier.go      |  22 +++++++
 pkg/proxy/pf/proxier_test.go |  41 ++++++++++++-
 pkg/proxy/pf/udpstates.go    | 108 +++++++++++++++++++++++++++++++++++
 3 files changed, 169 insertions(+), 2 deletions(-)
 create mode 100644 pkg/proxy/pf/udpstates.go

diff --git a/pkg/proxy/pf/proxier.go b/pkg/proxy/pf/proxier.go
index 0dd901f6d2c..64a664afc64 100644
--- a/pkg/proxy/pf/proxier.go
+++ b/pkg/proxy/pf/proxier.go
@@ -509,6 +509,9 @@ func (proxier *Proxier) syncProxyRules() error {
 		klog.ErrorS(err, "Failed to get node ip address matching nodeport cidrs, services with nodeport may not work as intended", "CIDRs", proxier.nodePortAddresses)
 	}
 
+	// UDP frontends and their current endpoints, for killStaleUDPStates.
+	udpFronts := udpFrontends{}
+
 	// Build rules for each service-port.
 	for svcName, svc := range proxier.svcPortMap {
 		svcInfo, ok := svc.(*servicePortInfo)
@@ -550,7 +553,25 @@ func (proxier *Proxier) syncProxyRules() error {
 				targetPort = port
 			}
 		}
+		if svcInfo.Protocol() == v1.ProtocolUDP {
+			endpoints := sets.New[string]()
+			for _, ep := range targetEndpoints {
+				endpoints.Insert(pfAddrPort(ep.IP(), targetPort))
+			}
+			udpFronts[pfAddrPort(svcInfo.ClusterIP().String(), svcInfo.Port())] = endpoints
+			if svcInfo.NodePort() != 0 {
+				for _, ip := range nodeIPs {
+					udpFronts[pfAddrPort(ip.String(), svcInfo.NodePort())] = endpoints
+				}
+			}
+		}
 		if len(targetEndpoints) == 0 {
+			// No endpoints (left): drop the rules that still redirect
+			// to the old ones.
+			cmd := proxier.exec.Command("pfctl", "-a", "cni-rdr/"+svcInfo.anchorName, "-F", "nat")
+			if out, err := cmd.CombinedOutput(); err != nil {
+				klog.ErrorS(err, "Failed to flush rules of service without endpoints", "service", svcName, "output", string(out))
+			}
 			continue
 		}
 
@@ -624,6 +645,7 @@ func (proxier *Proxier) syncProxyRules() error {
 			klog.Errorf("error loading rules input: '%s', output: %s, err: %v", input, output, err)
 		}
 	}
+	proxier.killStaleUDPStates(udpFronts)
 	for a := range staleAnchors {
 		proxier.logger.V(2).Info("deleting PF anchor", a)
 		cmd := proxier.exec.Command("pfctl", "-a", "cni-rdr/"+a, "-F", "nat")
