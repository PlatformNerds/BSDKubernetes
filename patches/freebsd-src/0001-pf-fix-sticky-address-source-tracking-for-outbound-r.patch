From d9f0015ba8970b9fc4f3b7642c01c43054c7694b Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Sat, 14 Nov 2026 22:12:13 -0700
Subject: [PATCH] pf: fix sticky-address source tracking for outbound rdr-to

pf_create_state() records the translated address of a sticky-address
translation pool in a PF_SN_NAT source node, taking it from the new state
key as nk->addr[1]. Index 1 is the destination only for inbound packets
(didx) and the source only for outbound ones (sidx), so this was right for
inbound rdr and outbound nat, but for

	pass out ... rdr-to { a, b } round-robin sticky-address

it stored the (unchanged) source address. The next connection from that
source found the source node and was redirected to the source's own
address: e.g. a host sending DNS to a Service address redirected by such a
rule got one answer, then every later query went to itself.

Pick the index from the kind of translation instead: the destination for
rdr (rdr rules, binat inbound, rdr-to), the source for nat (nat rules,
binat outbound, nat-to). Inbound rdr and outbound nat are unchanged.

Tested on 15.1 arm64: an outbound rdr-to sticky-address rule for UDP to
two DNS servers now keeps a client on one of them (source node
"client -> server"), where it previously mapped "client -> client".
---
 sys/netpfil/pf/pf.c | 29 +++++++++++++++++++++++++++--
 1 file changed, 27 insertions(+), 2 deletions(-)

diff --git a/sys/netpfil/pf/pf.c b/sys/netpfil/pf/pf.c
index 2d4efbe1e..b5da0c7e4 100644
--- a/sys/netpfil/pf/pf.c
+++ b/sys/netpfil/pf/pf.c
@@ -6674,18 +6674,43 @@ pf_create_state(struct pf_krule *r, struct pf_test_ctx *ctx,
 	}
 	/* src node for translation rule */
 	if (ctx->nr != NULL) {
+		bool rdr;
+
 		KASSERT(ctx->nat_pool != NULL, ("%s: nat_pool is NULL", __func__));
 		/*
 		 * The NAT addresses are chosen during ruleset parsing.
 		 * The new afto code stores post-nat addresses in nsaddr.
 		 * The old nat code (also used for new nat-to rules) creates
 		 * state keys and stores addresses in them.
+		 *
+		 * The address to remember is the translated destination for
+		 * a redirection and the translated source for NAT. In the
+		 * state key those are at didx and sidx, which depend on the
+		 * direction: a fixed index only worked for inbound rdr and
+		 * outbound nat, and made "pass out ... rdr-to ...
+		 * sticky-address" redirect every later connection of a
+		 * source to that source's own address.
 		 */
+		switch (ctx->nr->action) {
+		case PF_NAT:
+			rdr = false;
+			break;
+		case PF_RDR:
+			rdr = true;
+			break;
+		case PF_BINAT:
+			rdr = (pd->dir == PF_IN);
+			break;
+		default:
+			/* pass/match rules with nat-to or rdr-to */
+			rdr = (ctx->nat_pool == &ctx->nr->rdr);
+			break;
+		}
 		if ((ctx->nat_pool->opts & PF_POOL_STICKYADDR) &&
 		    (sn_reason = pf_insert_src_node(sns, snhs, ctx->nr,
 		    ctx->sk ? &(ctx->sk->addr[pd->sidx]) : pd->src, pd->af,
-		    ctx->nk ? &(ctx->nk->addr[1]) : &(pd->nsaddr), NULL,
-		    pd->naf, PF_SN_NAT)) != 0 ) {
+		    ctx->nk ? &(ctx->nk->addr[rdr ? pd->didx : pd->sidx]) :
+		    &(pd->nsaddr), NULL, pd->naf, PF_SN_NAT)) != 0 ) {
 			REASON_SET(&ctx->reason, sn_reason);
 			goto csfailed;
 		}
