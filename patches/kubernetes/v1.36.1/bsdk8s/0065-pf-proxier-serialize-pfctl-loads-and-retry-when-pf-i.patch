+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package pf
+
+import (
+	"errors"
+	"io"
+	"testing"
+	"time"
+
+	"k8s.io/utils/exec"
+	fakeexec "k8s.io/utils/exec/testing"
+)
+
+// fakePfctl returns an exec whose pfctl commands give results in turn, and
+// records each command's stdin.
+func fakePfctl(results []error, outputs []string, stdins *[]string) *fakeexec.FakeExec {
+	fe := &fakeexec.FakeExec{}
+	for i := range results {
+		i := i
+		fcmd := &fakeexec.FakeCmd{
+			CombinedOutputScript: []fakeexec.FakeAction{
+				func() ([]byte, []byte, error) { return []byte(outputs[i]), nil, results[i] },
+			},
+		}
+		fe.CommandScript = append(fe.CommandScript, func(cmd string, args ...string) exec.Cmd {
+			c := fakeexec.InitFakeCmd(fcmd, cmd, args...)
+			return &stdinRecorder{Cmd: c, fcmd: fcmd, stdins: stdins}
+		})
+	}
+	return fe
+}
+
+type stdinRecorder struct {
+	exec.Cmd
+	fcmd   *fakeexec.FakeCmd
+	stdins *[]string
+}
+
+func (r *stdinRecorder) CombinedOutput() ([]byte, error) {
+	if r.fcmd.Stdin != nil {
+		b, _ := io.ReadAll(r.fcmd.Stdin)
+		*r.stdins = append(*r.stdins, string(b))
+	}
+	return r.Cmd.CombinedOutput()
+}
+
+func TestRunPfctl(t *testing.T) {
+	sleep = func(time.Duration) {}
+	defer func() { sleep = time.Sleep }()
+	fail := errors.New("exit status 1")
+	busy := "pfctl: DIOCADDADDR: Device busy\n"
+
+	for _, tc := range []struct {
+		name    string
+		results []error
+		outputs []string
+		calls   int
+		wantErr bool
+	}{
+		{"ok", []error{nil}, []string{""}, 1, false},
+		{"busy, then ok", []error{fail, fail, nil}, []string{busy, busy, ""}, 3, false},
+		{"other error: no retry", []error{fail}, []string{"pfctl: syntax error\n"}, 1, true},
+		{"busy every time: gives up", make([]error, pfctlBusyRetries+1), nil, pfctlBusyRetries + 1, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if tc.outputs == nil {
+				for i := range tc.results {
+					tc.results[i] = fail
+					tc.outputs = append(tc.outputs, busy)
+				}
+			}
+			var stdins []string
+			fe := fakePfctl(tc.results, tc.outputs, &stdins)
+			_, err := runPfctl(fe, []byte("rules\n"), "-a", "cni-rdr/x", "-f", "-")
+			if (err != nil) != tc.wantErr {
+				t.Errorf("err = %v, want error %v", err, tc.wantErr)
+			}
+			if fe.CommandCalls != tc.calls {
+				t.Errorf("%d pfctl calls, want %d", fe.CommandCalls, tc.calls)
+			}
+			if len(stdins) != tc.calls {
+				t.Errorf("stdin seen %d times, want %d", len(stdins), tc.calls)
+			}
+			for i, s := range stdins {
+				if s != "rules\n" {
+					t.Errorf("call %d got stdin %q", i, s)
+				}
+			}
+		})
+	}
+}
diff --git a/pkg/proxy/pf/proxier.go b/pkg/proxy/pf/proxier.go
index 88c04eaa291..dddf74229fe 100644
--- a/pkg/proxy/pf/proxier.go
+++ b/pkg/proxy/pf/proxier.go
@@ -17,7 +17,6 @@ limitations under the License.
 package pf
 
 import (
-	"bytes"
 	"context"
 	"crypto/sha256"
 	"encoding/base32"
@@ -991,7 +990,7 @@ func (proxier *Proxier) hostRedirectRule(af, proto, source string, destinationIP
 // "-F all": that would also flush the global state table and source nodes.
 func flushAnchor(execer utilexec.Interface, anchor string) error {
 	for _, what := range []string{"nat", "rules"} {
-		if out, err := execer.Command("pfctl", "-a", anchor, "-F", what).CombinedOutput(); err != nil {
+		if out, err := runPfctl(execer, nil, "-a", anchor, "-F", what); err != nil {
 			return fmt.Errorf("pfctl -a %s -F %s: %w: %s", anchor, what, err, out)
 		}
 	}
@@ -1055,6 +1054,7 @@ func (proxier *Proxier) syncProxyRules() error {
 		}
 	}
 
+	loadFailures := 0
 	// TODO: figure out if partial sync makes sense. For now, just re-write all the rules
 	proxier.svcPortMap.Update(proxier.serviceChanges)
 	proxier.endpointsMap.Update(proxier.endpointsChanges)
@@ -1181,11 +1181,9 @@ func (proxier *Proxier) syncProxyRules() error {
 			klog.Infof("EOF")
 		}
 		input := proxier.pfData.Bytes()
-		cmd := proxier.exec.Command("pfctl", "-a", "cni-rdr/"+svcInfo.anchorName, "-f", "-")
-		cmd.SetStdin(bytes.NewReader(input))
-		output, err := cmd.CombinedOutput()
-		if err != nil {
+		if output, err := runPfctl(proxier.exec, input, "-a", "cni-rdr/"+svcInfo.anchorName, "-f", "-"); err != nil {
 			klog.Errorf("error loading rules input: '%s', output: %s, err: %v", input, output, err)
+			loadFailures++
 		}
 	}
 	proxier.killStaleUDPStates(udpFronts)
@@ -1217,6 +1215,11 @@ func (proxier *Proxier) syncProxyRules() error {
 	if err := proxier.serviceHealthServer.SyncEndpoints(proxier.endpointsMap.LocalReadyEndpoints()); err != nil {
 		proxier.logger.Error(err, "Error syncing healthcheck endpoints")
 	}
+	// A Service whose anchor failed to load keeps its old rules (or none)
+	// until the next sync: ask the runner to retry.
+	if loadFailures > 0 {
+		return fmt.Errorf("%d pf anchor(s) failed to load", loadFailures)
+	}
 	return nil
 }
 
