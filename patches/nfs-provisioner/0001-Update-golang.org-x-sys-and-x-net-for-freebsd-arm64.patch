From 0b43e290f17baa8b3d8a8a5b30c9a230429c50c1 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Thu, 19 Nov 2026 15:17:58 -0700
Subject: [PATCH] Update golang.org/x/sys and x/net for freebsd/arm64

The 2019 versions lack freebsd/arm64 definitions (x/sys: undefined
uint128; x/net/ipv4, ipv6: undefined sysIP_* constants).
---
 go.mod |  2 ++
 go.sum | 80 ++++++++++++++++++++++++++++++++++++++++++++++++----------
 2 files changed, 68 insertions(+), 14 deletions(-)

diff --git a/go.mod b/go.mod
index 2e60ce8..56d8e8d 100644
--- a/go.mod
+++ b/go.mod
@@ -9,7 +9,9 @@ require (
 	github.com/kubernetes-sigs/sig-storage-lib-external-provisioner v4.0.0+incompatible
 	github.com/miekg/dns v1.1.25 // indirect
 	github.com/prometheus/client_golang v1.1.0 // indirect
+	golang.org/x/net v0.34.0 // indirect
 	golang.org/x/oauth2 v0.0.0-20190604053449-0f29369cfe45 // indirect
+	golang.org/x/sys v0.30.0 // indirect
 	golang.org/x/time v0.0.0-20190308202827-9d24e82272b4 // indirect
