+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+// Package options contains all of the primary arguments for a kubelet.
+package options
+
+const defaultRootDir = "/var/db/kubelet"
diff --git a/cmd/kubelet/app/options/options_other.go b/cmd/kubelet/app/options/options_other.go
new file mode 100644
index 00000000000..1e22e1806df
--- /dev/null
+++ b/cmd/kubelet/app/options/options_other.go
@@ -0,0 +1,23 @@
