 ocijail/create.cpp      |  18 ++++++
 ocijail/sysctl.cpp      | 119 ++++++++++++++++++++++++++++++++++++++++
 ocijail/sysctl.h        |  35 ++++++++++++
 ocijail/sysctl_test.cpp |  48 ++++++++++++++++
 5 files changed, 229 insertions(+)
 create mode 100644 ocijail/sysctl.cpp
 create mode 100644 ocijail/sysctl.h
 create mode 100644 ocijail/sysctl_test.cpp

