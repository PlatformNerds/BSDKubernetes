From 4f6928cf9eee3abafb8097bd7e4e7ad440b3fffd Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Tue, 17 Nov 2026 19:27:16 -0700
Subject: [PATCH] linux: only report FUTEX_REQUEUE as unsupported when it is
 rejected

FUTEX_REQUEUE is allowed for brands with LINUX_BI_FUTEX_REQUEUE (musl),
but the "unsupported FUTEX_REQUEUE" message was logged before that check,
so every musl process that used the operation logged it although it
worked.  Log it only where the operation is rejected.
---
 sys/compat/linux/linux_futex.c | 17 +++++++++--------
 1 file changed, 9 insertions(+), 8 deletions(-)

diff --git a/sys/compat/linux/linux_futex.c b/sys/compat/linux/linux_futex.c
index 0586eb55a..0d71ad7a9 100644
--- a/sys/compat/linux/linux_futex.c
+++ b/sys/compat/linux/linux_futex.c
@@ -239,21 +239,22 @@ linux_futex(struct thread *td, struct linux_futex_args *args)
 		 * Glibc versions prior to 2.3.3 fall back to FUTEX_WAKE when
 		 * FUTEX_REQUEUE returned EINVAL.
 		 */
-		pem = pem_find(td->td_proc);
-		if ((pem->flags & LINUX_XDEPR_REQUEUEOP) == 0) {
-			linux_msg(td, "unsupported FUTEX_REQUEUE");
-			pem->flags |= LINUX_XDEPR_REQUEUEOP;
-		}
-
 		/*
 		 * The above is true, however musl libc does make use of the
 		 * futex requeue operation, allow operation for brands which
-		 * set LINUX_BI_FUTEX_REQUEUE bit of Brandinfo flags.
+		 * set LINUX_BI_FUTEX_REQUEUE bit of Brandinfo flags.  Only
+		 * report the operation as unsupported where it is rejected.
 		 */
 		p = td->td_proc;
 		const Elf_Brandinfo *bi = p->p_elf_brandinfo;
-		if (bi == NULL || ((bi->flags & LINUX_BI_FUTEX_REQUEUE)) == 0)
+		if (bi == NULL || ((bi->flags & LINUX_BI_FUTEX_REQUEUE)) == 0) {
+			pem = pem_find(p);
+			if ((pem->flags & LINUX_XDEPR_REQUEUEOP) == 0) {
+				linux_msg(td, "unsupported FUTEX_REQUEUE");
+				pem->flags |= LINUX_XDEPR_REQUEUEOP;
+			}
 			return (EINVAL);
+		}
 		args->val3_compare = false;
 		/* FALLTHROUGH */
 
