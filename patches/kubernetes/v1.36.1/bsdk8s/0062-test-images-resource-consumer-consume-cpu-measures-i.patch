 .../consume-cpu/consume_cpu_freebsd.go        | 60 +++++++++++++++++++
 2 files changed, 61 insertions(+), 1 deletion(-)
 create mode 100644 test/images/resource-consumer/consume-cpu/consume_cpu_freebsd.go

