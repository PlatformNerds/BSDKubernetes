From a117596d64907424b7e480026b94bfefe3e937a3 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Mon, 16 Nov 2026 15:10:22 -0700
Subject: [PATCH] linux(arm64): add a musl brand and fix the glibc interpreter
 path

The arm64 Linux brand list had only the glibc brand, and its interpreter
path was amd64's ("/lib64/ld-linux-x86-64.so.2") instead of
"/lib/ld-linux-aarch64.so.1", so dynamic Linux binaries were only
recognized through kern.elf64.fallback_brand.  musl (Alpine) binaries
were then run as glibc ones without LINUX_BI_FUTEX_REQUEUE, so the
FUTEX_REQUEUE that musl's condition variables use failed with EINVAL and
wakeups were lost: Node.js hung joining its threads at exit.

Fix the glibc interpreter path and add a musl brand, as amd64 has.
---
 sys/arm64/linux/linux_sysvec.c | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/sys/arm64/linux/linux_sysvec.c b/sys/arm64/linux/linux_sysvec.c
index ac05820f8..cf3ac83ac 100644
--- a/sys/arm64/linux/linux_sysvec.c
+++ b/sys/arm64/linux/linux_sysvec.c
@@ -597,15 +597,34 @@ static const Elf64_Brandinfo linux_glibc2brand = {
 	.brand		= ELFOSABI_LINUX,
 	.machine	= EM_AARCH64,
 	.compat_3_brand	= "Linux",
-	.interp_path	= "/lib64/ld-linux-x86-64.so.2",
+	.interp_path	= "/lib/ld-linux-aarch64.so.1",
 	.sysvec		= &elf_linux_sysvec,
 	.interp_newpath	= NULL,
 	.brand_note	= &linux64_brandnote,
 	.flags		= BI_CAN_EXEC_DYN | BI_BRAND_NOTE
 };
 
+/*
+ * musl uses FUTEX_REQUEUE (e.g. in its condition variables); without this
+ * brand, Alpine binaries only ran through kern.elf64.fallback_brand, as
+ * plain Linux binaries, got EINVAL for it and lost wakeups (Node.js hung
+ * joining its threads at exit).
+ */
+static const Elf64_Brandinfo linux_muslbrand = {
+	.brand		= ELFOSABI_LINUX,
+	.machine	= EM_AARCH64,
+	.compat_3_brand	= "Linux",
+	.interp_path	= "/lib/ld-musl-aarch64.so.1",
+	.sysvec		= &elf_linux_sysvec,
+	.interp_newpath	= NULL,
+	.brand_note	= &linux64_brandnote,
+	.flags		= BI_CAN_EXEC_DYN | BI_BRAND_NOTE |
+			    LINUX_BI_FUTEX_REQUEUE
+};
+
 const Elf64_Brandinfo *linux_brandlist[] = {
 	&linux_glibc2brand,
+	&linux_muslbrand,
 	NULL
 };
 
