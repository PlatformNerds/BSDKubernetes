+func (c *SCTPConn) GetStatus() (*Status, error) { // Status
+	sctpStatus := &Status{}
+	optlen := unsafe.Sizeof(*sctpStatus)
+	_, _, err := getsockopt(
+		c.fd(),
+		SCTP_STATUS,
+		uintptr(unsafe.Pointer(sctpStatus)),
+		uintptr(unsafe.Pointer(&optlen)),
+	)
+	return sctpStatus, err
+}
