From 197843ecb265d9fb88428bf03c28d1a2d9d4c361 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Wed, 18 Nov 2026 22:07:28 -0700
Subject: [PATCH] jail: optionally let jails sharing a vnet see each other's
 sockets

Socket visibility (netstat, sockstat: the pcblist sysctls via
cr_canseeinpcb/cr_canseesocket) follows prison_check(): a jail sees its
own and its descendants' sockets, not its siblings'. Container runtimes
put each container of a pod in a sibling jail below a vnet jail that
owns the pod's network stack, so a readiness probe like
`netstat -na | grep LISTEN` in one container misses the listener in
another, which on Linux (one network namespace) it sees.

Add security.bsd.see_vnet_sockets (off by default). When set, jails whose
prisons share the same vnet, other than the host's, may also see each
other's sockets. Jails on the host's network stack never qualify, so it
exposes nothing outside a vnet jail's own tree.
---
 share/man/man7/security.7 | 12 ++++++++++++
 sys/kern/kern_prot.c      | 28 +++++++++++++++++++++++++++-
 sys/netinet/in_prot.c     |  2 +-
 sys/sys/proc.h            |  1 +
 4 files changed, 41 insertions(+), 2 deletions(-)

diff --git a/share/man/man7/security.7 b/share/man/man7/security.7
index 4cbe4b309..180ad7bce 100644
--- a/share/man/man7/security.7
+++ b/share/man/man7/security.7
@@ -978,6 +978,18 @@ Same, for subjects and objects owned by a different gid.
 .It Va security.bsd.see_jail_proc
 Same, for subjects and objects belonging to a different jail, including
 sub-jails.
+.It Va security.bsd.see_vnet_sockets
+When enabled, jails that share a network stack of their own (a
+.Va vnet
+jail and the jails below it that inherit its
+.Va vnet )
+may see each other's sockets, for example in
+.Xr netstat 1
+and
+.Xr sockstat 1 ,
+as processes sharing a network namespace do on Linux.
+Jails on the host's network stack are never affected.
+Off by default.
 .It Va security.bsd.conservative_signals
 When enabled, unprivileged users are only allowed to send job control
 and usual termination signals like
diff --git a/sys/kern/kern_prot.c b/sys/kern/kern_prot.c
index 38d2b8d0b..f6ad03786 100644
--- a/sys/kern/kern_prot.c
+++ b/sys/kern/kern_prot.c
@@ -1936,6 +1936,32 @@ SYSCTL_INT(_security_bsd, OID_AUTO, see_jail_proc, CTLFLAG_RW,
     &see_jail_proc, 0,
     "Unprivileged processes may see subjects/objects with different jail ids");
 
+/*
+ * 'see_vnet_sockets' lets jails that share a network stack of their own (a
+ * vnet jail and the jails below it that inherit its vnet) see each other's
+ * sockets, as processes in one network namespace do on Linux: the containers
+ * of a pod run in sibling jails sharing the pod jail's vnet, and tools like
+ * netstat in one of them otherwise miss the others' listeners. Jails on the
+ * host's network stack never qualify.
+ */
+static int	see_vnet_sockets = 0;
+SYSCTL_INT(_security_bsd, OID_AUTO, see_vnet_sockets, CTLFLAG_RW,
+    &see_vnet_sockets, 0,
+    "Jails sharing a vnet of their own may see each other's sockets");
+
+/*
+ * Determine whether u1 may see sockets of u2 because both are in the same
+ * jail-owned vnet, according to the 'see_vnet_sockets' policy.
+ */
+bool
+cr_seevnetpeer(struct ucred *u1, struct ucred *u2)
+{
+	struct prison *p1 = u1->cr_prison, *p2 = u2->cr_prison;
+
+	return (see_vnet_sockets && p1->pr_vnet == p2->pr_vnet &&
+	    p1->pr_vnet != prison0.pr_vnet);
+}
+
 /*-
  * Determine if u1 "can see" the subject specified by u2, according to the
  * 'see_jail_proc' policy.
@@ -2394,7 +2420,7 @@ cr_canseesocket(struct ucred *cred, struct socket *so)
 	int error;
 
 	error = prison_check(cred, so->so_cred);
-	if (error)
+	if (error && !cr_seevnetpeer(cred, so->so_cred))
 		return (ENOENT);
 #ifdef MAC
 	error = mac_socket_check_visible(cred, so);
diff --git a/sys/netinet/in_prot.c b/sys/netinet/in_prot.c
index 69f0f3694..fa447050e 100644
--- a/sys/netinet/in_prot.c
+++ b/sys/netinet/in_prot.c
@@ -55,7 +55,7 @@ cr_canseeinpcb(struct ucred *cred, struct inpcb *inp)
 	int error;
 
 	error = prison_check(cred, inp->inp_cred);
-	if (error)
+	if (error && !cr_seevnetpeer(cred, inp->inp_cred))
 		return (ENOENT);
 #ifdef MAC
 	INP_LOCK_ASSERT(inp);
diff --git a/sys/sys/proc.h b/sys/sys/proc.h
index 71b0be5bc..309b281cc 100644
--- a/sys/sys/proc.h
+++ b/sys/sys/proc.h
@@ -1159,6 +1159,7 @@ struct	thread *choosethread(void);
 int	cr_bsd_visible(struct ucred *u1, struct ucred *u2);
 int	cr_cansee(struct ucred *u1, struct ucred *u2);
 int	cr_canseesocket(struct ucred *cred, struct socket *so);
+bool	cr_seevnetpeer(struct ucred *u1, struct ucred *u2);
 int	cr_cansignal(struct ucred *cred, struct proc *proc, int signum);
 int	enterpgrp(struct proc *p, pid_t pgid, struct pgrp *pgrp,
 	    struct session *sess);
-- 
