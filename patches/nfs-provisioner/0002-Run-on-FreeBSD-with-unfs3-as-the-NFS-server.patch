diff --git a/pkg/volume/export_ganesha.go b/pkg/volume/export_ganesha.go
new file mode 100644
index 0000000..e310d53
--- /dev/null
+++ b/pkg/volume/export_ganesha.go
@@ -0,0 +1,85 @@
+//go:build !freebsd
+// +build !freebsd
+
+/*
