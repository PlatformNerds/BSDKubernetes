From d64e7983f8a15fc48e58a8b8140c6a5051aec865 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Fri, 13 Nov 2026 22:10:07 -0700
Subject: [PATCH 3/5] rctl: clear stale rules at create, tolerate EPERM; add
 tests

rctl rules are keyed by jail name and outlive the jail, so remove any
rules left under the container's name (crash, or a delete done by an
ocijail without rctl support) before adding ours. Treat EPERM like
ENOSYS so ocijail still works when it runs inside a jail where rctl is
not permitted: limits are then reported as not enforced instead of
failing the container.

Tests (root suite, skipped unless kern.racct.enable=1):
- test_resources_rctl_rules: the exact rules after create, none after delete
- test_resources_memory_kill: 256 MiB under a 64 MiB limit -> SIGKILL
- test_resources_stale_rules: a planted stale rule is cleared at create
---
 ocijail/create.cpp | 11 ++++---
 ocijail/rctl.cpp   | 10 ++++---
 ocijail/rctl.h     |  8 ++---
 test/run_test.py   | 74 ++++++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 91 insertions(+), 12 deletions(-)

diff --git a/ocijail/create.cpp b/ocijail/create.cpp
index 19a3005..696dec8 100644
--- a/ocijail/create.cpp
+++ b/ocijail/create.cpp
@@ -465,7 +465,10 @@ void create::run() {
     auto j = jail::create(jconf);
 
     // Resource limits: translate OCI linux.resources into rctl rules on this
-    // jail. Rules are keyed by jail name and removed again in delete.
+    // jail. Rules are keyed by jail name (not jid) and outlive the jail, so
+    // first drop any stale rules left under this name (e.g. by a crash, or a
+    // delete done by an ocijail without rctl support); delete removes ours.
+    rctl::remove(jail_name);
     if (config.contains("linux") && config["linux"].contains("resources")) {
         auto t = rctl::from_oci_resources(config["linux"]["resources"]);
         for (const auto& ign : t.ignored) {
@@ -474,9 +477,9 @@ void create::run() {
         }
         try {
             if (!rctl::apply(jail_name, t.rules) && !t.rules.empty()) {
-                app_.log() << "warning: RACCT/RCTL disabled "
-                              "(kern.racct.enable=0), resource limits not "
-                              "enforced for " << jail_name;
+                app_.log() << "warning: rctl unavailable (kern.racct.enable=0, "
+                              "or not permitted in this jail), resource "
+                              "limits not enforced for " << jail_name;
             }
         } catch (...) {
             rctl::remove(jail_name);
diff --git a/ocijail/rctl.cpp b/ocijail/rctl.cpp
index d975c53..a0b1dc2 100644
--- a/ocijail/rctl.cpp
+++ b/ocijail/rctl.cpp
@@ -66,8 +66,10 @@ bool apply(const std::string& jail_name, const std::vector<std::string>& rules)
     for (const auto& r : rules) {
         auto rule = "jail:" + jail_name + ":" + r;
         if (::rctl_add_rule(rule.c_str(), rule.size() + 1, nullptr, 0) < 0) {
-            if (errno == ENOSYS) {
-                return false;  // RACCT disabled (kern.racct.enable=0)
+            if (errno == ENOSYS || errno == EPERM) {
+                // ENOSYS: RACCT disabled (kern.racct.enable=0).
+                // EPERM: not allowed here, e.g. ocijail running in a jail.
+                return false;
             }
             throw std::system_error(
                 errno, std::system_category(), "rctl_add_rule " + rule);
@@ -79,8 +81,8 @@ bool apply(const std::string& jail_name, const std::vector<std::string>& rules)
 void remove(const std::string& jail_name) {
     auto filter = "jail:" + jail_name;
     if (::rctl_remove_rule(filter.c_str(), filter.size() + 1, nullptr, 0) < 0) {
-        if (errno == ENOSYS || errno == ESRCH) {
-            return;
+        if (errno == ENOSYS || errno == ESRCH || errno == EPERM) {
+            return;  // no RACCT, no matching rules, or not permitted here
         }
         throw std::system_error(
             errno, std::system_category(), "rctl_remove_rule " + filter);
diff --git a/ocijail/rctl.h b/ocijail/rctl.h
index 44cf1ee..f94556a 100644
--- a/ocijail/rctl.h
+++ b/ocijail/rctl.h
@@ -37,14 +37,14 @@ struct translation {
 };
 translation from_oci_resources(const nlohmann::json& resources);
 
-// Add "jail:<jail_name>:<rule>" for each rule. Returns false (and adds
-// nothing) if RACCT/RCTL is unavailable (kern.racct.enable=0 -> ENOSYS);
-// throws on any other error.
+// Add "jail:<jail_name>:<rule>" for each rule. Returns false if RACCT/RCTL
+// is unavailable (kern.racct.enable=0 -> ENOSYS) or not permitted (EPERM,
+// e.g. when ocijail itself runs inside a jail); throws on any other error.
 bool apply(const std::string& jail_name, const std::vector<std::string>& rules);
 
 // Remove every rule whose subject is jail:<jail_name>. rctl rules are keyed
 // by jail *name* and outlive the jail, so this must run on delete. Missing
-// RACCT or "no matching rule" are not errors.
+// RACCT, "no matching rule" and EPERM are not errors.
 void remove(const std::string& jail_name);
 
 }  // namespace ocijail::rctl
diff --git a/test/run_test.py b/test/run_test.py
index 2172ce3..cc5489d 100644
--- a/test/run_test.py
+++ b/test/run_test.py
@@ -13,6 +13,18 @@ import sys
 import tempfile
 import unittest
 
+def racct_enabled():
+    try:
+        out = subprocess.run(["sysctl", "-n", "kern.racct.enable"],
+                             capture_output=True, text=True)
+        return out.stdout.strip() == "1"
+    except OSError:
+        return False
+
+def rctl_rules(subject):
+    out = subprocess.run(["rctl", subject], capture_output=True, text=True)
+    return sorted(line for line in out.stdout.splitlines() if line)
+
 cmd = "ocijail/ocijail"
 
 def recv_fds(sock, msglen, maxfds):
@@ -139,6 +151,68 @@ class test_run(unittest.TestCase):
         ret, _, _ = self.run_with_config(c)
         self.assertEqual(ret, 42)
 
+    @unittest.skipUnless(racct_enabled(), "needs kern.racct.enable=1")
+    def test_resources_rctl_rules(self):
+        # OCI linux.resources become rctl rules on the container's jail,
+        # and are removed again by delete.
+        c = self.config()
+        c["process"]["args"] = ["sh", "-c", "exit 0"]
+        c["linux"] = {"resources": {
+            "memory": {"limit": 64 << 20},
+            "cpu": {"quota": 50000, "period": 100000, "shares": 512},
+            "pids": {"limit": 100},
+        }}
+        subject = f"jail:{self.container_id}"
+        with tempfile.TemporaryDirectory() as bundle_dir:
+            with open(os.path.join(bundle_dir, "config.json"), "w") as f:
+                json.dump(c, f)
+            pid, stdout, stderr = self.create(bundle_dir)
+            self.assertEqual(rctl_rules(subject), sorted([
+                f"{subject}:maxproc:deny=100",
+                f"{subject}:memoryuse:sigkill=67108864",
+                f"{subject}:pcpu:deny=50",
+            ]))
+            self.start()
+            os.waitpid(pid, os.WEXITED)
+            stdout.close()
+            stderr.close()
+            self.delete()
+        self.assertEqual(rctl_rules(subject), [])
+
+    @unittest.skipUnless(racct_enabled(), "needs kern.racct.enable=1")
+    def test_resources_memory_kill(self):
+        # A container whose resident memory exceeds memory.limit is killed
+        # (racctd checks once per second, hence the sleep).
+        c = self.config()
+        c["process"]["args"] = [
+            sys.executable, "-c",
+            "import time; b = bytearray(256 << 20); time.sleep(10)",
+        ]
+        c["linux"] = {"resources": {"memory": {"limit": 64 << 20}}}
+        with tempfile.TemporaryDirectory() as bundle_dir:
+            with open(os.path.join(bundle_dir, "config.json"), "w") as f:
+                json.dump(c, f)
+            pid, stdout, stderr = self.create(bundle_dir)
+            self.start()
+            _, status = os.waitpid(pid, os.WEXITED)
+            stdout.close()
+            stderr.close()
+        self.assertTrue(os.WIFSIGNALED(status))
+        self.assertEqual(os.WTERMSIG(status), 9)
+
+    @unittest.skipUnless(racct_enabled(), "needs kern.racct.enable=1")
+    def test_resources_stale_rules(self):
+        # rctl rules are keyed by jail name and outlive the jail; create must
+        # not let a new container inherit rules left under its name.
+        subject = f"jail:{self.container_id}"
+        subprocess.run(["rctl", "-a", f"{subject}:openfiles:deny=1000"],
+                       check=True)
+        c = self.config()
+        c["process"]["args"] = ["sh", "-c", "exit 0"]
+        ret, _, _ = self.run_with_config(c)
+        self.assertEqual(ret, 0)
+        self.assertEqual(rctl_rules(subject), [])
+
     def test_stdout(self):
         c = self.config()
         c["process"]["args"] = ["echo", "Hello", "World"]
