 internal/config/device/device_freebsd_test.go | 31 ++++++
 internal/config/device/device_linux.go        | 63 ------------
 internal/config/device/device_unsupported.go  |  2 +-
 internal/config/device/parse.go               | 69 +++++++++++++
 internal/factory/container/device_freebsd.go  | 23 ++---
 6 files changed, 207 insertions(+), 77 deletions(-)
