From b6ed5894e2f1606143b87beddb8f151bd45c8efa Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Thu, 19 Nov 2026 15:52:49 -0700
Subject: [PATCH] mount-utils: give up on an unreachable NFS server on FreeBSD,
 like Linux

FreeBSD's mount_nfs retries a server that doesn't answer forever, a minute
apart, so the kubelet's mount never returned: the volume's operation stayed
pending, and the pod could neither start nor be torn down (seen with a
recycler pod whose NFS server was gone: still retrying hours later). Linux's
mount.nfs gives up after two minutes in the foreground. Add retrycnt=3
(three attempts a minute apart) to NFS mounts that set no retry count.
---
 .../src/k8s.io/mount-utils/mount_freebsd.go   | 22 +++++++++++++++++++
 .../k8s.io/mount-utils/mount_freebsd_test.go  | 18 +++++++++++++++
 2 files changed, 40 insertions(+)

diff --git a/staging/src/k8s.io/mount-utils/mount_freebsd.go b/staging/src/k8s.io/mount-utils/mount_freebsd.go
index 84d9ccdb9a4..180ba1ed4b6 100644
--- a/staging/src/k8s.io/mount-utils/mount_freebsd.go
+++ b/staging/src/k8s.io/mount-utils/mount_freebsd.go
@@ -198,6 +198,7 @@ func (mounter *SafeFormatAndMount) diskLooksUnformatted(disk string) (bool, erro
 // systemdMountRequired is an extension of option to decide whether uses systemd
 // mount.
 func (mounter *Mounter) doMount(mountCmd string, source string, target string, fstype string, options []string, sensitiveOptions []string, mountFlags []string) error {
+	options = withNFSRetryCount(fstype, options)
 	mountArgs, mountArgsLogStr := MakeMountArgsSensitiveWithMountFlags(source, target, fstype, options, sensitiveOptions, mountFlags)
 
 	// Logging with sensitive mount options removed.
@@ -212,6 +213,27 @@ func (mounter *Mounter) doMount(mountCmd string, source string, target string, f
 	return err
 }
 
+// nfsRetryCount bounds how often mount_nfs(8) tries an NFS server that doesn't
+// answer. mount_nfs retries forever by default, a minute apart, so the mount
+// would never return: the volume's operation stays pending, and its pod can
+// neither start nor be torn down. Linux's mount.nfs gives up after two minutes
+// in the foreground; three attempts a minute apart take as long.
+const nfsRetryCount = "retrycnt=3"
+
+// withNFSRetryCount adds nfsRetryCount to the options of an NFS mount that
+// doesn't set a retry count itself.
+func withNFSRetryCount(fstype string, options []string) []string {
+	if fstype != "nfs" {
+		return options
+	}
+	for _, o := range options {
+		if strings.HasPrefix(o, "retrycnt=") {
+			return options
+		}
+	}
+	return append(append([]string(nil), options...), nfsRetryCount)
+}
+
 // MakeMountArgsSensitive makes the arguments to the mount(8) command.
 // sensitiveOptions is an extension of options except they will not be logged (because they may contain sensitive material)
 func MakeMountArgsSensitive(source, target, fstype string, options []string, sensitiveOptions []string) (mountArgs []string, mountArgsLogStr string) {
diff --git a/staging/src/k8s.io/mount-utils/mount_freebsd_test.go b/staging/src/k8s.io/mount-utils/mount_freebsd_test.go
index 9eb5e9dcb41..10c03dc9b0e 100644
--- a/staging/src/k8s.io/mount-utils/mount_freebsd_test.go
+++ b/staging/src/k8s.io/mount-utils/mount_freebsd_test.go
@@ -50,3 +50,21 @@ func TestNullfsMountRefs(t *testing.T) {
 		}
 	}
 }
+
+func TestWithNFSRetryCount(t *testing.T) {
+	for _, tc := range []struct {
+		fstype  string
+		options []string
+		want    []string
+	}{
+		{"nfs", nil, []string{"retrycnt=3"}},
+		{"nfs", []string{"vers=4.1"}, []string{"vers=4.1", "retrycnt=3"}},
+		{"nfs", []string{"retrycnt=0"}, []string{"retrycnt=0"}},
+		{"nullfs", []string{"ro"}, []string{"ro"}},
+		{"tmpfs", nil, nil},
+	} {
+		if got := withNFSRetryCount(tc.fstype, tc.options); !reflect.DeepEqual(got, tc.want) {
+			t.Errorf("withNFSRetryCount(%q, %v) = %v, want %v", tc.fstype, tc.options, got, tc.want)
+		}
+	}
+}
