+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package volume
+
+import (
+	"fmt"
+	"io/ioutil"
+	"regexp"
+	"strconv"
+	"strings"
+	"syscall"
+
+	"k8s.io/api/core/v1"
+)
+
+// UnfsPidFile is where unfsd(8) writes its pid; the server package starts it
+// with this file.
+const UnfsPidFile = "/var/run/unfsd.pid"
+
+// On FreeBSD the provisioner's own NFS server (run-server) is unfs3, a user
+// space NFSv3 server: NFS Ganesha has no FreeBSD port, and the kernel nfsd
+// needs a privileged pod (jail allow.nfsd). unfs3 reads a Linux-style exports
+// file and rereads it on SIGHUP.
+type unfsExporter struct {
+	genericExporter
+}
+
+var _ exporter = &unfsExporter{}
+
+// newServerExporter returns the exporter for the NFS server this provisioner
+// runs (run-server).
+func newServerExporter(config string) exporter {
+	return &unfsExporter{
+		genericExporter: *newGenericExporter(&unfsExportBlockCreator{}, config, regexp.MustCompile("Export_Id = ([0-9]+);")),
+	}
+}
+
+// Export makes unfsd reread its exports file, which has the new export.
+func (e *unfsExporter) Export(_ string) error {
+	return reloadUnfsd()
+}
+
+// Unexport makes unfsd reread its exports file, which no longer has the export.
+func (e *unfsExporter) Unexport(_ *v1.PersistentVolume) error {
+	return reloadUnfsd()
+}
+
+func reloadUnfsd() error {
+	b, err := ioutil.ReadFile(UnfsPidFile)
+	if err != nil {
+		return fmt.Errorf("error reading unfsd pid file %s: %v", UnfsPidFile, err)
+	}
+	pid, err := strconv.Atoi(strings.TrimSpace(string(b)))
+	if err != nil {
+		return fmt.Errorf("bad unfsd pid file %s: %v", UnfsPidFile, err)
+	}
+	if err := syscall.Kill(pid, syscall.SIGHUP); err != nil {
+		return fmt.Errorf("error signalling unfsd (pid %d): %v", pid, err)
+	}
+	return nil
+}
+
+type unfsExportBlockCreator struct{}
+
+var _ exportBlockCreator = &unfsExportBlockCreator{}
+
+// CreateExportBlock creates the lines to add to unfsd's exports file. unfs3
+// has no fsid option (and no "*" host: no host means every host), so the
+// export ID, which the provisioner recovers from the file after a restart,
+// goes in a comment.
+func (e *unfsExportBlockCreator) CreateExportBlock(exportID, path string, rootSquash bool, exportSubnet string) string {
+	squash := "no_root_squash"
+	if rootSquash {
+		squash = "root_squash"
+	}
+	host := exportSubnet
+	if host == "*" {
+		host = ""
+	}
+	return "\n# Export_Id = " + exportID + ";\n" + path + " " + host + "(rw,insecure," + squash + ")\n"
+}
