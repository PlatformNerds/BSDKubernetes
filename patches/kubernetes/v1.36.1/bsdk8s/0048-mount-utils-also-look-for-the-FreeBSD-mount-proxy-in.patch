From 7f7a3429684499eb495054669ec447533aece966 Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Sat, 21 Nov 2026 18:07:09 -0700
Subject: [PATCH] mount-utils: also look for the FreeBSD mount proxy in
 plugins/kubernetes.io/csi

Many CSI node plugins mount only the kubelet's staging directory
(plugins/kubernetes.io/csi) and their own plugins/<driver>/, not all of
plugins/, so they couldn't reach the proxy's socket there. The proxy now
listens in both places.
---
 staging/src/k8s.io/mount-utils/mount_proxy_freebsd.go | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/staging/src/k8s.io/mount-utils/mount_proxy_freebsd.go b/staging/src/k8s.io/mount-utils/mount_proxy_freebsd.go
index 75ccb39fb3e..88bad95fde8 100644
--- a/staging/src/k8s.io/mount-utils/mount_proxy_freebsd.go
+++ b/staging/src/k8s.io/mount-utils/mount_proxy_freebsd.go
@@ -39,9 +39,14 @@ import (
 // MountProxySocketEnv overrides where the proxy's socket is looked for.
 const MountProxySocketEnv = "BSDK8S_MOUNT_PROXY"
 
+// The proxy listens in the kubelet's plugins/ and in plugins/kubernetes.io/csi/:
+// many node plugins mount only the latter (the kubelet's staging directory)
+// and their own plugins/<driver>/, not all of plugins/.
 var mountProxySockets = []string{
 	"/var/db/kubelet/plugins/bsdk8s-mount-proxy.sock",
 	"/var/lib/kubelet/plugins/bsdk8s-mount-proxy.sock",
+	"/var/db/kubelet/plugins/kubernetes.io/csi/bsdk8s-mount-proxy.sock",
+	"/var/lib/kubelet/plugins/kubernetes.io/csi/bsdk8s-mount-proxy.sock",
 }
 
 type mountProxyRequest struct {
