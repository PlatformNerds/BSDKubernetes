From 8d3a8a30bb19f5f3df0bf6903d264572bf1a86eb Mon Sep 17 00:00:00 2001
From: PePe Amengual <2208324+jamengual@users.noreply.github.com>
Date: Thu, 19 Nov 2026 22:00:07 -0700
Subject: [PATCH] mount-utils: mount through bsdk8s-mount-proxy from a FreeBSD
 jail

FreeBSD has no mount propagation: a CSI node plugin runs in a jail and sees
the kubelet's directories through nullfs, so its mounts are invisible to the
kubelet and the runtime (Linux uses mountPropagation: Bidirectional; Windows
has the same problem and uses csi-proxy).

When running in a jail (security.jail.jailed) and the socket of
bsdk8s-mount-proxy is reachable (BSDK8S_MOUNT_PROXY, else
<kubelet root>/plugins/bsdk8s-mount-proxy.sock for /var/db/kubelet or
/var/lib/kubelet), Mount, Unmount and List go to the proxy, a host daemon
that runs them with the caller's paths translated to host paths
(BSDKubernetes components/mount-proxy). IsMountPoint and UnmountWithForce
use List and so go through it too. Outside a jail nothing changes.

A CSI driver built against this mount-utils needs no FreeBSD code: the
csi-hostpath e2e driver's volumes mount this way.
---
 .../src/k8s.io/mount-utils/mount_freebsd.go   |   9 ++
 .../k8s.io/mount-utils/mount_proxy_freebsd.go | 127 ++++++++++++++++++
 2 files changed, 136 insertions(+)
 create mode 100644 staging/src/k8s.io/mount-utils/mount_proxy_freebsd.go

diff --git a/staging/src/k8s.io/mount-utils/mount_freebsd.go b/staging/src/k8s.io/mount-utils/mount_freebsd.go
index a736259c55f..72995c0d7c2 100644
--- a/staging/src/k8s.io/mount-utils/mount_freebsd.go
+++ b/staging/src/k8s.io/mount-utils/mount_freebsd.go
@@ -67,6 +67,9 @@ func (mounter *Mounter) MountSensitiveWithoutSystemdWithMountFlags(source string
 }
 
 func (mounter *Mounter) MountSensitive(source string, target string, fstype string, options []string, sensitiveOptions []string) error {
+	if socket := mountProxySocket(); socket != "" {
+		return mountThroughProxy(socket, source, target, fstype, append(append([]string(nil), options...), sensitiveOptions...))
+	}
 	if isBindMount(options) {
 		fstype = "nullfs"
 	}
@@ -79,6 +82,9 @@ func (mounter *Mounter) MountSensitive(source string, target string, fstype stri
 
 // Unmount unmounts target with umount(8).
 func (mounter *Mounter) Unmount(target string) error {
+	if socket := mountProxySocket(); socket != "" {
+		return unmountThroughProxy(socket, target)
+	}
 	klog.V(4).Infof("Unmounting %s", target)
 	command := exec.Command("umount", "-f", target)
 	output, err := command.CombinedOutput()
@@ -90,6 +96,9 @@ func (mounter *Mounter) Unmount(target string) error {
 
 // List returns the mounted file systems, from getfsstat(2).
 func (mounter *Mounter) List() ([]MountPoint, error) {
+	if socket := mountProxySocket(); socket != "" {
+		return listThroughProxy(socket)
+	}
 	count, err := unix.Getfsstat(nil, unix.MNT_NOWAIT)
 	if err != nil {
 		return nil, err
diff --git a/staging/src/k8s.io/mount-utils/mount_proxy_freebsd.go b/staging/src/k8s.io/mount-utils/mount_proxy_freebsd.go
new file mode 100644
index 00000000000..75ccb39fb3e
--- /dev/null
+++ b/staging/src/k8s.io/mount-utils/mount_proxy_freebsd.go
@@ -0,0 +1,127 @@
+//go:build freebsd
+
